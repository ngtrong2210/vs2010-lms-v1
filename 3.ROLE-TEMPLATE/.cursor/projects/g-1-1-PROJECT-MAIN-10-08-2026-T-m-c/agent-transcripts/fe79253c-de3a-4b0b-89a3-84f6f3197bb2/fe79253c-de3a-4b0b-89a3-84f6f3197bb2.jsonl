{"role":"assistant","message":{"content":[{"type":"text","text":"Tôi sẽ xem cấu trúc project trước, rồi tạo file HTML hướng dẫn Vue.js cơ bản."},{"type":"tool_use","name":"Glob","input":{"glob_pattern":"**/*.{html,md,vue}"}},{"type":"tool_use","name":"Shell","input":{"command":"Get-ChildItem -Force | Select-Object Name, Mode | Format-Table -AutoSize","description":"List workspace root contents"}}]}}
{"role":"assistant","message":{"content":[{"type":"text","text":"Workspace trống — tôi sẽ tạo một file HTML tự chứa, có ví dụ Vue chạy trực tiếp trên trang."},{"type":"tool_use","name":"Write","input":{"path":"g:\\1.1-PROJECT-MAIN\\10.08.2026 - Tâm đức\\huong-dan-vuejs-co-ban.html","contents":"<!DOCTYPE html>\n<html lang=\"vi\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Hướng dẫn Vue.js cơ bản</title>\n  <script src=\"https://unpkg.com/vue@3/dist/vue.global.js\"></script>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\" />\n  <style>\n    :root {\n      --bg: #0f1a17;\n      --bg-soft: #162420;\n      --surface: #1c2e29;\n      --surface-2: #243832;\n      --line: #2f4a42;\n      --text: #e8f2ee;\n      --muted: #9bb5ab;\n      --accent: #3ecf8e;\n      --accent-dim: #2a9d6a;\n      --warn: #e8b84a;\n      --code-bg: #0b1412;\n      --radius: 12px;\n      --shadow: 0 18px 40px rgba(0, 0, 0, 0.28);\n      --max: 920px;\n    }\n\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      font-family: \"Be Vietnam Pro\", sans-serif;\n      background:\n        radial-gradient(ellipse 80% 50% at 10% -10%, rgba(62, 207, 142, 0.18), transparent 55%),\n        radial-gradient(ellipse 60% 40% at 90% 0%, rgba(42, 157, 106, 0.12), transparent 50%),\n        linear-gradient(180deg, #0c1513 0%, var(--bg) 40%, #0d1614 100%);\n      color: var(--text);\n      line-height: 1.65;\n      min-height: 100vh;\n    }\n\n    a { color: var(--accent); text-decoration: none; }\n    a:hover { text-decoration: underline; }\n\n    .wrap {\n      width: min(100% - 2rem, var(--max));\n      margin-inline: auto;\n    }\n\n    /* —— Top nav —— */\n    .topbar {\n      position: sticky;\n      top: 0;\n      z-index: 20;\n      backdrop-filter: blur(12px);\n      background: rgba(15, 26, 23, 0.82);\n      border-bottom: 1px solid rgba(47, 74, 66, 0.6);\n    }\n\n    .topbar-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 1rem;\n      padding: 0.85rem 0;\n      flex-wrap: wrap;\n    }\n\n    .brand {\n      font-weight: 700;\n      font-size: 1.05rem;\n      letter-spacing: -0.02em;\n      color: var(--text);\n      display: flex;\n      align-items: center;\n      gap: 0.55rem;\n    }\n\n    .brand-mark {\n      width: 28px;\n      height: 28px;\n      border-radius: 8px;\n      background: linear-gradient(135deg, var(--accent), var(--accent-dim));\n      display: grid;\n      place-items: center;\n      color: #062016;\n      font-weight: 800;\n      font-size: 0.85rem;\n    }\n\n    .toc-links {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.35rem 0.9rem;\n      font-size: 0.85rem;\n    }\n\n    .toc-links a {\n      color: var(--muted);\n      text-decoration: none;\n    }\n\n    .toc-links a:hover { color: var(--accent); }\n\n    /* —— Hero —— */\n    .hero {\n      padding: 3.5rem 0 2.5rem;\n      border-bottom: 1px solid var(--line);\n    }\n\n    .hero h1 {\n      font-size: clamp(1.85rem, 4vw, 2.6rem);\n      line-height: 1.2;\n      letter-spacing: -0.03em;\n      margin-bottom: 0.75rem;\n    }\n\n    .hero h1 span { color: var(--accent); }\n\n    .hero p {\n      color: var(--muted);\n      font-size: 1.05rem;\n      max-width: 38rem;\n    }\n\n    .badge-row {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.5rem;\n      margin-top: 1.25rem;\n    }\n\n    .badge {\n      font-size: 0.78rem;\n      font-weight: 500;\n      color: var(--accent);\n      background: rgba(62, 207, 142, 0.12);\n      border: 1px solid rgba(62, 207, 142, 0.28);\n      padding: 0.3rem 0.7rem;\n      border-radius: 999px;\n    }\n\n    /* —— Sections —— */\n    section {\n      padding: 2.75rem 0;\n      border-bottom: 1px solid var(--line);\n    }\n\n    section:last-of-type { border-bottom: none; }\n\n    .section-label {\n      font-size: 0.75rem;\n      font-weight: 600;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n      color: var(--accent-dim);\n      margin-bottom: 0.4rem;\n    }\n\n    h2 {\n      font-size: 1.45rem;\n      letter-spacing: -0.02em;\n      margin-bottom: 0.65rem;\n    }\n\n    h3 {\n      font-size: 1.05rem;\n      margin: 1.5rem 0 0.5rem;\n      color: #cfe6dc;\n    }\n\n    p, li { color: #c5d9d0; }\n\n    ul, ol {\n      padding-left: 1.25rem;\n      margin: 0.75rem 0 1rem;\n    }\n\n    li { margin: 0.35rem 0; }\n\n    .lead {\n      color: var(--muted);\n      margin-bottom: 1.25rem;\n    }\n\n    /* —— Code —— */\n    pre {\n      background: var(--code-bg);\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      padding: 1rem 1.1rem;\n      overflow-x: auto;\n      margin: 0.85rem 0 1.1rem;\n      font-family: \"JetBrains Mono\", monospace;\n      font-size: 0.82rem;\n      line-height: 1.55;\n      color: #d4e8df;\n      box-shadow: var(--shadow);\n    }\n\n    code {\n      font-family: \"JetBrains Mono\", monospace;\n      font-size: 0.86em;\n      background: rgba(62, 207, 142, 0.1);\n      color: var(--accent);\n      padding: 0.12em 0.4em;\n      border-radius: 5px;\n    }\n\n    pre code {\n      background: none;\n      color: inherit;\n      padding: 0;\n      font-size: inherit;\n    }\n\n    .kw { color: #7dd3a8; }\n    .str { color: #e8b84a; }\n    .cm { color: #6a857a; }\n    .tag { color: #8fd4b5; }\n    .attr { color: #a8d5c4; }\n\n    /* —— Demo panels —— */\n    .demo {\n      display: grid;\n      gap: 0.85rem;\n      margin: 1.1rem 0 0.5rem;\n    }\n\n    @media (min-width: 720px) {\n      .demo.split {\n        grid-template-columns: 1fr 1fr;\n        align-items: start;\n      }\n    }\n\n    .panel {\n      background: var(--surface);\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      overflow: hidden;\n    }\n\n    .panel-head {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0.55rem 0.9rem;\n      background: var(--surface-2);\n      border-bottom: 1px solid var(--line);\n      font-size: 0.78rem;\n      font-weight: 600;\n      color: var(--muted);\n      letter-spacing: 0.04em;\n      text-transform: uppercase;\n    }\n\n    .panel-body {\n      padding: 1rem 1.1rem;\n    }\n\n    .panel pre {\n      margin: 0;\n      border: none;\n      border-radius: 0;\n      box-shadow: none;\n    }\n\n    .live-note {\n      font-size: 0.8rem;\n      color: var(--warn);\n      margin-top: 0.35rem;\n    }\n\n    /* —— Interactive widgets —— */\n    .widget input[type=\"text\"],\n    .widget input[type=\"number\"],\n    .widget select {\n      width: 100%;\n      max-width: 280px;\n      background: var(--bg-soft);\n      border: 1px solid var(--line);\n      color: var(--text);\n      border-radius: 8px;\n      padding: 0.55rem 0.75rem;\n      font: inherit;\n      margin: 0.35rem 0 0.75rem;\n    }\n\n    .widget input:focus,\n    .widget select:focus {\n      outline: 2px solid rgba(62, 207, 142, 0.45);\n      border-color: var(--accent-dim);\n    }\n\n    .widget button {\n      font: inherit;\n      font-weight: 600;\n      background: linear-gradient(135deg, var(--accent), var(--accent-dim));\n      color: #062016;\n      border: none;\n      border-radius: 8px;\n      padding: 0.5rem 1rem;\n      cursor: pointer;\n      margin: 0.25rem 0.35rem 0.25rem 0;\n      transition: transform 0.15s ease, filter 0.15s ease;\n    }\n\n    .widget button:hover {\n      filter: brightness(1.08);\n      transform: translateY(-1px);\n    }\n\n    .widget button.ghost {\n      background: transparent;\n      color: var(--accent);\n      border: 1px solid rgba(62, 207, 142, 0.4);\n    }\n\n    .widget .result {\n      margin-top: 0.75rem;\n      padding-top: 0.75rem;\n      border-top: 1px dashed var(--line);\n      color: var(--text);\n    }\n\n    .widget .muted { color: var(--muted); font-size: 0.9rem; }\n\n    .todo-list { list-style: none; padding: 0; margin: 0.5rem 0 0; }\n    .todo-list li {\n      display: flex;\n      align-items: center;\n      gap: 0.5rem;\n      padding: 0.4rem 0;\n      border-bottom: 1px solid rgba(47, 74, 66, 0.5);\n      color: var(--text);\n    }\n\n    .todo-list li.done span {\n      text-decoration: line-through;\n      color: var(--muted);\n    }\n\n    .pill {\n      display: inline-block;\n      font-size: 0.75rem;\n      font-weight: 600;\n      padding: 0.2rem 0.55rem;\n      border-radius: 6px;\n      background: rgba(62, 207, 142, 0.15);\n      color: var(--accent);\n    }\n\n    .callout {\n      background: rgba(62, 207, 142, 0.08);\n      border-left: 3px solid var(--accent);\n      border-radius: 0 var(--radius) var(--radius) 0;\n      padding: 0.85rem 1rem;\n      margin: 1rem 0;\n      color: #c5d9d0;\n      font-size: 0.95rem;\n    }\n\n    .grid-2 {\n      display: grid;\n      gap: 1rem;\n      margin-top: 1rem;\n    }\n\n    @media (min-width: 640px) {\n      .grid-2 { grid-template-columns: 1fr 1fr; }\n    }\n\n    .mini-card {\n      background: var(--surface);\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      padding: 1rem 1.1rem;\n    }\n\n    .mini-card strong {\n      display: block;\n      margin-bottom: 0.35rem;\n      color: var(--accent);\n    }\n\n    footer {\n      padding: 2rem 0 3rem;\n      color: var(--muted);\n      font-size: 0.88rem;\n      text-align: center;\n    }\n\n    /* motion */\n    @keyframes fade-up {\n      from { opacity: 0; transform: translateY(12px); }\n      to { opacity: 1; transform: translateY(0); }\n    }\n\n    .hero, section {\n      animation: fade-up 0.55s ease both;\n    }\n\n    section:nth-of-type(2) { animation-delay: 0.05s; }\n    section:nth-of-type(3) { animation-delay: 0.08s; }\n  </style>\n</head>\n<body>\n  <header class=\"topbar\">\n    <div class=\"wrap topbar-inner\">\n      <div class=\"brand\">\n        <span class=\"brand-mark\">V</span>\n        Vue.js cơ bản\n      </div>\n      <nav class=\"toc-links\" aria-label=\"Mục lục\">\n        <a href=\"#gioi-thieu\">Giới thiệu</a>\n        <a href=\"#cai-dat\">Cài đặt</a>\n        <a href=\"#template\">Template</a>\n        <a href=\"#directives\">Directives</a>\n        <a href=\"#su-kien\">Sự kiện</a>\n        <a href=\"#form\">Form</a>\n        <a href=\"#computed\">Computed</a>\n        <a href=\"#list\">Danh sách</a>\n        <a href=\"#components\">Component</a>\n      </nav>\n    </div>\n  </header>\n\n  <main>\n    <div class=\"hero wrap\">\n      <h1>Hướng dẫn <span>Vue.js</span> cơ bản</h1>\n      <p>\n        Tài liệu ngắn gọn kèm ví dụ chạy trực tiếp trên trang.\n        Mở file này bằng trình duyệt — không cần cài đặt thêm.\n      </p>\n      <div class=\"badge-row\">\n        <span class=\"badge\">Vue 3 · CDN</span>\n        <span class=\"badge\">Composition API &amp; Options API</span>\n        <span class=\"badge\">Ví dụ tương tác</span>\n      </div>\n    </div>\n\n    <!-- 1. Giới thiệu -->\n    <section id=\"gioi-thieu\">\n      <div class=\"wrap\">\n        <p class=\"section-label\">01</p>\n        <h2>Vue.js là gì?</h2>\n        <p class=\"lead\">\n          Vue là thư viện JavaScript dùng để xây giao diện web theo hướng khai báo (declarative)\n          và dựa trên component. Bạn mô tả UI theo dữ liệu; khi dữ liệu đổi, Vue cập nhật DOM.\n        </p>\n        <div class=\"grid-2\">\n          <div class=\"mini-card\">\n            <strong>Reactive</strong>\n            Đổi biến → giao diện đổi theo, không cần tự thao tác DOM.\n          </div>\n          <div class=\"mini-card\">\n            <strong>Component</strong>\n            Tách UI thành khối tái sử dụng: header, form, thẻ sản phẩm…\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- 2. Cài đặt -->\n    <section id=\"cai-dat\">\n      <div class=\"wrap\">\n        <p class=\"section-label\">02</p>\n        <h2>Cách nhanh nhất: CDN</h2>\n        <p class=\"lead\">Dùng CDN để học — chỉ cần một file HTML.</p>\n<pre><code><span class=\"tag\">&lt;script</span> <span class=\"attr\">src</span>=<span class=\"str\">\"https://unpkg.com/vue@3/dist/vue.global.js\"</span><span class=\"tag\">&gt;&lt;/script&gt;</span>\n\n<span class=\"tag\">&lt;div</span> <span class=\"attr\">id</span>=<span class=\"str\">\"app\"</span><span class=\"tag\">&gt;</span>\n  {{ message }}\n<span class=\"tag\">&lt;/div&gt;</span>\n\n<span class=\"tag\">&lt;script&gt;</span>\n  <span class=\"kw\">const</span> { createApp } = Vue\n\n  createApp({\n    data() {\n      <span class=\"kw\">return</span> {\n        message: <span class=\"str\">'Xin chào Vue!'</span>\n      }\n    }\n  }).mount(<span class=\"str\">'#app'</span>)\n<span class=\"tag\">&lt;/script&gt;</span></code></pre>\n        <div class=\"callout\">\n          Dự án thật nên dùng <code>npm create vue@latest</code> (Vite) để có SFC\n          (<code>.vue</code>), router, và build tối ưu.\n        </div>\n      </div>\n    </section>\n\n    <!-- 3. Template -->\n    <section id=\"template\">\n      <div class=\"wrap\">\n        <p class=\"section-label\">03</p>\n        <h2>Template &amp; nội suy (Mustache)</h2>\n        <p class=\"lead\">Dùng <code>{{ }}</code> để hiển thị giá trị từ data.</p>\n\n        <div class=\"demo split\">\n          <div class=\"panel\">\n            <div class=\"panel-head\">Code</div>\n            <pre><code>data() {\n  return { name: 'An' }\n}\n\n<span class=\"cm\">&lt;!-- template --&gt;</span>\n&lt;p&gt;Xin chào, {{ name }}!&lt;/p&gt;</code></pre>\n          </div>\n          <div class=\"panel\">\n            <div class=\"panel-head\">Chạy thử <span class=\"pill\">Live</span></div>\n            <div class=\"panel-body widget\" id=\"demo-hello\">\n              <label class=\"muted\">Đổi tên:</label>\n              <input type=\"text\" v-model=\"name\" placeholder=\"Nhập tên…\" />\n              <div class=\"result\">Xin chào, <strong>{{ name || '…' }}</strong>!</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- 4. Directives -->\n    <section id=\"directives\">\n      <div class=\"wrap\">\n        <p class=\"section-label\">04</p>\n        <h2>Directives cơ bản</h2>\n        <p class=\"lead\">Directive là thuộc tính đặc biệt bắt đầu bằng <code>v-</code>.</p>\n\n        <h3><code>v-bind</code> — gắn thuộc tính</h3>\n        <p>Viết tắt: <code>:attr</code></p>\n<pre><code>&lt;img <span class=\"attr\">:src</span>=<span class=\"str\">\"imageUrl\"</span> <span class=\"attr\">:alt</span>=<span class=\"str\">\"title\"</span> /&gt;\n&lt;a <span class=\"attr\">:href</span>=<span class=\"str\">\"link\"</span>&gt;Mở trang&lt;/a&gt;</code></pre>\n\n        <h3><code>v-if</code> / <code>v-else</code> / <code>v-show</code></h3>\n        <p><code>v-if</code> thêm/xóa khỏi DOM; <code>v-show</code> chỉ ẩn/hiện bằng CSS.</p>\n\n        <div class=\"demo split\">\n          <div class=\"panel\">\n            <div class=\"panel-head\">Code</div>\n            <pre><code>&lt;button @click=\"visible = !visible\"&gt;\n  Bật / tắt\n&lt;/button&gt;\n&lt;p v-if=\"visible\"&gt;Nội dung đang hiện&lt;/p&gt;\n&lt;p v-else&gt;Đã ẩn&lt;/p&gt;</code></pre>\n          </div>\n          <div class=\"panel\">\n            <div class=\"panel-head\">Chạy thử <span class=\"pill\">Live</span></div>\n            <div class=\"panel-body widget\" id=\"demo-if\">\n              <button @click=\"visible = !visible\">Bật / tắt</button>\n              <div class=\"result\">\n                <p v-if=\"visible\">Nội dung đang <strong>hiện</strong>.</p>\n                <p v-else class=\"muted\">Nội dung đã <strong>ẩn</strong> (<code>v-else</code>).</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- 5. Events -->\n    <section id=\"su-kien\">\n      <div class=\"wrap\">\n        <p class=\"section-label\">05</p>\n        <h2>Sự kiện với <code>v-on</code> / <code>@</code></h2>\n        <p class=\"lead\">Lắng nghe click, input, submit… và gọi method.</p>\n\n        <div class=\"demo split\">\n          <div class=\"panel\">\n            <div class=\"panel-head\">Code</div>\n            <pre><code>data() {\n  return { count: 0 }\n},\nmethods: {\n  increase() { this.count++ },\n  reset() { this.count = 0 }\n}\n\n&lt;button @click=\"increase\"&gt;+1&lt;/button&gt;\n&lt;button @click=\"reset\"&gt;Reset&lt;/button&gt;\n&lt;p&gt;Đếm: {{ count }}&lt;/p&gt;</code></pre>\n          </div>\n          <div class=\"panel\">\n            <div class=\"panel-head\">Chạy thử <span class=\"pill\">Live</span></div>\n            <div class=\"panel-body widget\" id=\"demo-count\">\n              <button @click=\"increase\">+1</button>\n              <button class=\"ghost\" @click=\"reset\">Reset</button>\n              <div class=\"result\">Đếm: <strong>{{ count }}</strong></div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- 6. Form / v-model -->\n    <section id=\"form\">\n      <div class=\"wrap\">\n        <p class=\"section-label\">06</p>\n        <h2>Two-way binding với <code>v-model</code></h2>\n        <p class=\"lead\">\n          <code>v-model</code> đồng bộ input ↔ data. Thay đổi một bên, bên kia cập nhật theo.\n        </p>\n\n        <div class=\"demo split\">\n          <div class=\"panel\">\n            <div class=\"panel-head\">Code</div>\n            <pre><code>&lt;input v-model=\"email\" /&gt;\n&lt;p&gt;Email: {{ email }}&lt;/p&gt;\n\n&lt;select v-model=\"city\"&gt;\n  &lt;option&gt;Hà Nội&lt;/option&gt;\n  &lt;option&gt;Đà Nẵng&lt;/option&gt;\n  &lt;option&gt;TP.HCM&lt;/option&gt;\n&lt;/select&gt;</code></pre>\n          </div>\n          <div class=\"panel\">\n            <div class=\"panel-head\">Chạy thử <span class=\"pill\">Live</span></div>\n            <div class=\"panel-body widget\" id=\"demo-form\">\n              <label class=\"muted\">Email</label>\n              <input type=\"text\" v-model=\"email\" placeholder=\"ban@email.com\" />\n              <label class=\"muted\">Thành phố</label>\n              <select v-model=\"city\">\n                <option>Hà Nội</option>\n                <option>Đà Nẵng</option>\n                <option>TP.HCM</option>\n              </select>\n              <div class=\"result\">\n                <div>Email: <strong>{{ email || '—' }}</strong></div>\n                <div>Thành phố: <strong>{{ city }}</strong></div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- 7. Computed -->\n    <section id=\"computed\">\n      <div class=\"wrap\">\n        <p class=\"section-label\">07</p>\n        <h2>Computed properties</h2>\n        <p class=\"lead\">\n          Dùng khi giá trị phụ thuộc data khác — Vue cache kết quả cho đến khi dependency đổi.\n        </p>\n\n        <div class=\"demo split\">\n          <div class=\"panel\">\n            <div class=\"panel-head\">Code</div>\n            <pre><code>data() {\n  return { price: 100000, qty: 2 }\n},\ncomputed: {\n  total() {\n    return this.price * this.qty\n  }\n}\n\n&lt;p&gt;Tổng: {{ total.toLocaleString() }} đ&lt;/p&gt;</code></pre>\n          </div>\n          <div class=\"panel\">\n            <div class=\"panel-head\">Chạy thử <span class=\"pill\">Live</span></div>\n            <div class=\"panel-body widget\" id=\"demo-computed\">\n              <label class=\"muted\">Đơn giá (VNĐ)</label>\n              <input type=\"number\" v-model.number=\"price\" min=\"0\" step=\"1000\" />\n              <label class=\"muted\">Số lượng</label>\n              <input type=\"number\" v-model.number=\"qty\" min=\"0\" />\n              <div class=\"result\">\n                Tổng: <strong>{{ total.toLocaleString('vi-VN') }} đ</strong>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- 8. List -->\n    <section id=\"list\">\n      <div class=\"wrap\">\n        <p class=\"section-label\">08</p>\n        <h2>Danh sách với <code>v-for</code></h2>\n        <p class=\"lead\">Luôn gắn <code>:key</code> ổn định để Vue theo dõi từng phần tử.</p>\n\n        <div class=\"demo split\">\n          <div class=\"panel\">\n            <div class=\"panel-head\">Code</div>\n            <pre><code>&lt;li\n  v-for=\"todo in todos\"\n  :key=\"todo.id\"\n  :class=\"{ done: todo.done }\"\n&gt;\n  &lt;input\n    type=\"checkbox\"\n    v-model=\"todo.done\"\n  /&gt;\n  {{ todo.text }}\n&lt;/li&gt;</code></pre>\n          </div>\n          <div class=\"panel\">\n            <div class=\"panel-head\">Chạy thử <span class=\"pill\">Live</span></div>\n            <div class=\"panel-body widget\" id=\"demo-list\">\n              <input\n                type=\"text\"\n                v-model=\"newText\"\n                @keyup.enter=\"addTodo\"\n                placeholder=\"Thêm việc… rồi Enter\"\n              />\n              <button @click=\"addTodo\">Thêm</button>\n              <ul class=\"todo-list\">\n                <li\n                  v-for=\"todo in todos\"\n                  :key=\"todo.id\"\n                  :class=\"{ done: todo.done }\"\n                >\n                  <input type=\"checkbox\" v-model=\"todo.done\" />\n                  <span>{{ todo.text }}</span>\n                </li>\n              </ul>\n              <p class=\"muted\" style=\"margin-top:0.75rem\">\n                Còn {{ remaining }} việc chưa xong\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- 9. Components -->\n    <section id=\"components\">\n      <div class=\"wrap\">\n        <p class=\"section-label\">09</p>\n        <h2>Component (ý tưởng)</h2>\n        <p class=\"lead\">\n          Component là khối UI độc lập: nhận dữ liệu qua <code>props</code>, báo sự kiện ra ngoài bằng\n          <code>emit</code>.\n        </p>\n<pre><code><span class=\"cm\">// Đăng ký component con</span>\n<span class=\"kw\">const</span> HelloCard = {\n  props: [<span class=\"str\">'title'</span>],\n  template: `<span class=\"tag\">&lt;div</span> <span class=\"attr\">class</span>=<span class=\"str\">\"card\"</span><span class=\"tag\">&gt;</span>{{ title }}<span class=\"tag\">&lt;/div&gt;</span>`\n}\n\ncreateApp({\n  components: { HelloCard },\n  template: `<span class=\"tag\">&lt;HelloCard</span> <span class=\"attr\">title</span>=<span class=\"str\">\"Xin chào\"</span> <span class=\"tag\">/&gt;</span>`\n}).mount(<span class=\"str\">'#app'</span>)</code></pre>\n\n        <div class=\"callout\">\n          Trong dự án Vite, mỗi component thường là file <code>HelloCard.vue</code> gồm\n          <code>&lt;template&gt;</code>, <code>&lt;script&gt;</code>, <code>&lt;style&gt;</code>.\n        </div>\n\n        <h3>Options API vs Composition API</h3>\n        <div class=\"grid-2\">\n          <div class=\"mini-card\">\n            <strong>Options API</strong>\n            Tổ chức theo <code>data</code>, <code>methods</code>, <code>computed</code>\n            — dễ bắt đầu (như các demo trên trang này).\n          </div>\n          <div class=\"mini-card\">\n            <strong>Composition API</strong>\n            Dùng <code>setup()</code> / <code>&lt;script setup&gt;</code> với\n            <code>ref</code>, <code>computed</code> — linh hoạt hơn khi logic phức tạp.\n          </div>\n        </div>\n<pre><code><span class=\"cm\">// Composition API (rút gọn)</span>\n<span class=\"kw\">import</span> { ref } <span class=\"kw\">from</span> <span class=\"str\">'vue'</span>\n\n<span class=\"kw\">const</span> count = ref(0)\n<span class=\"kw\">function</span> increase() { count.value++ }</code></pre>\n      </div>\n    </section>\n\n    <!-- Cheat sheet -->\n    <section id=\"cheat\">\n      <div class=\"wrap\">\n        <p class=\"section-label\">Tóm tắt</p>\n        <h2>Bảng ghi nhớ nhanh</h2>\n        <div class=\"grid-2\" style=\"margin-top:1rem\">\n          <div class=\"mini-card\">\n            <strong>{{ }}</strong>\n            Hiển thị text từ data\n          </div>\n          <div class=\"mini-card\">\n            <strong>v-bind / :</strong>\n            Gắn thuộc tính HTML động\n          </div>\n          <div class=\"mini-card\">\n            <strong>v-on / @</strong>\n            Lắng nghe sự kiện\n          </div>\n          <div class=\"mini-card\">\n            <strong>v-model</strong>\n            Đồng bộ form ↔ data\n          </div>\n          <div class=\"mini-card\">\n            <strong>v-if / v-show</strong>\n            Điều kiện hiển thị\n          </div>\n          <div class=\"mini-card\">\n            <strong>v-for + :key</strong>\n            Lặp danh sách\n          </div>\n        </div>\n        <p style=\"margin-top:1.5rem\">\n          Tài liệu gốc:\n          <a href=\"https://vi.vuejs.org/guide/introduction.html\" target=\"_blank\" rel=\"noopener\">\n            vi.vuejs.org\n          </a>\n        </p>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"wrap\">\n      Hướng dẫn Vue.js cơ bản · Mở file HTML này trong trình duyệt để chạy demo\n    </div>\n  </footer>\n\n  <script>\n    const { createApp } = Vue\n\n    createApp({\n      data: () => ({ name: 'An' })\n    }).mount('#demo-hello')\n\n    createApp({\n      data: () => ({ visible: true })\n    }).mount('#demo-if')\n\n    createApp({\n      data: () => ({ count: 0 }),\n      methods: {\n        increase() { this.count++ },\n        reset() { this.count = 0 }\n      }\n    }).mount('#demo-count')\n\n    createApp({\n      data: () => ({ email: '', city: 'Hà Nội' })\n    }).mount('#demo-form')\n\n    createApp({\n      data: () => ({ price: 100000, qty: 2 }),\n      computed: {\n        total() { return this.price * this.qty }\n      }\n    }).mount('#demo-computed')\n\n    createApp({\n      data: () => ({\n        newText: '',\n        nextId: 3,\n        todos: [\n          { id: 1, text: 'Học template Vue', done: true },\n          { id: 2, text: 'Thử v-model & v-for', done: false }\n        ]\n      }),\n      computed: {\n        remaining() {\n          return this.todos.filter(t => !t.done).length\n        }\n      },\n      methods: {\n        addTodo() {\n          const text = this.newText.trim()\n          if (!text) return\n          this.todos.push({ id: this.nextId++, text, done: false })\n          this.newText = ''\n        }\n      }\n    }).mount('#demo-list')\n  </script>\n</body>\n</html>\n"}}]}}
