ween\">\r\n                        <div class=\"mb-2 mb-md-0\">\r\n                            <span class=\"me-3\">\r\n                                <strong>Giáo viên:</strong>\r\n                                <b><asp:Label runat=\"server\" ID=\"lblTeacher\"></asp:Label></b>\r\n                            </span>\r\n                            <span>\r\n                                <strong>Môn học/Mô-đun:</strong>\r\n                                <asp:Label runat=\"server\" ID=\"lblClassSubjectName\"></asp:Label>\r\n                            </span>\r\n                        </div>\r\n\r\n                        <div class=\"d-flex flex-wrap gap-2\">\r\n                            <asp:Button runat=\"server\" ID=\"btnExportExcel\" Text=\"Xuất excel\" Visible=\"false\"\r\n                                CssClass=\"btn btn-success btn-sm fw-normal\" onclick=\"btnExportExcel_Click\" />\r\n                            <asp:Button runat=\"server\" ID=\"btnView_SubjectCheckingSummary\"\r\n                                Text=\"Xem bảng điểm danh\" CssClass=\"btn btn-primary btn-sm fw-normal\" Visible=\"false\"\r\n                                onclick=\"btnView_SubjectCheckingSummary_Click\" />\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"table-responsive fs-7 align-middle my-3 px-0\">\r\n                    <asp:Repeater runat=\"server\" ID=\"rptList\"\r\n                        onitemdatabound=\"rptList_ItemDataBound\">\r\n\r\n                        <HeaderTemplate>\r\n                            <table class=\"table table-bordered table-hover align-middle\">\r\n                                <thead class=\"table-primary-2 align-middle text-nowrap\">\r\n                                    <tr class=\"fw-bold\">\r\n                                        <td>TT</td>\r\n                                        <td class='<%= GetCssName(\"Date\") %>'><asp:LinkButton runat=\"server\" ID='lbtTitle' OnClick='lbtTitle_Click' CommandArgument='Date'>Ngày</asp:LinkButton></td>\r\n                                        <td class='<%= GetCssName(\"Session\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton6' OnClick='lbtTitle_Click' CommandArgument='Session'>Buổi</asp:LinkButton></td>\r\n                                        <td class='<%= GetCssName(\"TheoryQuantity\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton1' OnClick='lbtTitle_Click' CommandArgument='TheoryQuantity'>Lý thuyết</asp:LinkButton></td>\r\n                                        <td class='<%= GetCssName(\"PracticeQuantity\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton2' OnClick='lbtTitle_Click' CommandArgument='PracticeQuantity'>Thực hành</asp:LinkButton></td>\r\n                                        <td class='<%= GetCssName(\"TestQuantity\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton4' OnClick='lbtTitle_Click' CommandArgument='TestQuantity'>Kiểm tra</asp:LinkButton></td>\r\n                                        <td class='<%= GetCssName(\"OffStudentCount\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton8' OnClick='lbtTitle_Click' CommandArgument='OffStudentCount'>Số học sinh vắng</asp:LinkButton></td>\r\n                                        <td class='<%= GetCssName(\"LearningContent\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton3' OnClick='lbtTitle_Click' CommandArgument='LearningContent'>Tóm tắt nội dung bài giảng, kiểm tra</asp:LinkButton></td>\r\n                                        <td class='<%= GetCssName(\"RequestContent\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton5' OnClick='lbtTitle_Click' CommandArgument='RequestContent'>Yêu cầu cơ sở vật chất</asp:LinkButton></td>\r\n                                        <td class='<%= GetCssName(\"Description\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton9' OnClick='lbtTitle_Click' CommandArgument='Description'>Ghi chú</asp:LinkButton></td>\r\n                                        <td style=\"min-width:100px\"></td>\r\n                                        <%--<td><asp:LinkButton runat=\"server\" ID='LinkButton4' OnClientClick='return CheckingAllClick();' CommandArgument='Checking'>Điểm danh tất cả</asp:LinkButton></td>--%>\r\n                                    </tr>\r\n                                </thead>\r\n                                <tbody>\r\n                        </HeaderTemplate>\r\n\r\n                        <ItemTemplate>\r\n                            <tr <%= WriteEventRow() %>>\r\n                                <td align=\"center\"><%= intRowIndex %></td>\r\n                                <td>\r\n                                    <%#Eval(\"DateText\")%>\r\n                                </td>\r\n                                <td>\r\n                                    <%#Eval(\"SessionText\")%>\r\n                                </td>\r\n                                <td>\r\n                                    <%# Eval(\"TheoryQuantity\")%>\r\n                                </td>\r\n                                <td>\r\n                                    <%# Eval(\"PracticeQuantity\")%>\r\n                                </td>\r\n                                <td>\r\n                                    <%# Eval(\"TestQuantity\")%>\r\n                                </td>\r\n                                <td>\r\n                                    <%# Eval(\"OffStudentCount\")%>\r\n                                </td>\r\n                                <td>\r\n                                    <%# Eval(\"LearningContent\")%>\r\n                                    <%# GetLink(Eval(\"ContentFile\"))%>\r\n                                </td>\r\n                                <td>\r\n                                    <%# Eval(\"RequestContent\")%>\r\n                                </td>\r\n                                <td>\r\n                                    <%# Eval(\"Description\")%>\r\n                                    <%# Eval(\"EmptyWarning\") %>\r\n                                </td>\r\n                                <td class=\"text-center align-middle\">\r\n                                    <asp:HiddenField ID=\"hidTeacherIDOfSchedule\" runat=\"server\" Value='<%# Eval(\"TeacherIDOfSchedule\") %>' />\r\n                                    <asp:HiddenField ID=\"hidTheoryQuantity\" runat=\"server\" Value='<%# Eval(\"TheoryQuantity\") %>' />\r\n                                    <asp:HiddenField ID=\"hidPracticeQuantity\" runat=\"server\" Value='<%# Eval(\"PracticeQuantity\") %>' />\r\n                                    <asp:HiddenField ID=\"hidTestQuantity\" runat=\"server\" Value='<%# Eval(\"TestQuantity\") %>' />\r\n                                    <asp:HiddenField ID=\"hidSession\" runat=\"server\" Value='<%# Eval(\"Session\") %>' />\r\n\r\n                                    <div class=\"d-flex flex-column gap-1 align-items-center\">\r\n                                        <asp:LinkButton runat=\"server\" ID=\"lbtEdit\" ToolTip=\"Sửa\"\r\n                                            OnClick='lbtEdit_Click' CssClass=\"btn btn-sm btn-outline-primary w-100\"\r\n                                            Visible='<%# AllowEdit(Eval(\"TeacherIDOfSchedule\")) %>'\r\n                                            CommandName='<%# Eval(\"Date\") %>'\r\n                                            CommandArgument='<%# Eval(\"ScheduleCheckingID\") %>'>\r\n                                            <i class=\"bi bi-pencil\"></i>\r\n                                        </asp:LinkButton>\r\n\r\n                                        <asp:LinkButton runat=\"server\" ID=\"lbtSubjectChecking\" ToolTip=\"Điểm danh\"\r\n                                            OnClick='lbtSubjectChecking_Click' CssClass=\"btn btn-sm btn-outline-success w-100\"\r\n                                            Text=\"Điểm danh\"\r\n                                            OnClientClick=\"window.location.href = '#SubjectChecking'\"\r\n                                            Visible='<%# AllowEdit(Eval(\"TeacherIDOfSchedule\")) %>'\r\n                                            CommandName='<%# Eval(\"Date\") %>'\r\n                                            CommandArgument='<%# Eval(\"Session\") %>'>\r\n                                            <i class=\"bi bi-check2-circle\"></i>\r\n                                        </asp:LinkButton>\r\n                                    </div>\r\n                                </td>\r\n                            </tr>\r\n                        </ItemTemplate>\r\n\r\n                        <FooterTemplate>\r\n                                </tbody>\r\n                            </table>\r\n                        </FooterTemplate>\r\n\r\n                    </asp:Repeater>\r\n                </div>\r\n\r\n            </ContentTemplate>\r\n        </asp:UpdatePanel>\r\n\r\n        <uc1:Edit ID=\"uEdit\" runat=\"server\" />\r\n\r\n        <p id=\"SubjectChecking\"></p>\r\n\r\n        <asp:UpdatePanel ID=\"udpSubjectChecking\" runat=\"server\" UpdateMode=\"Conditional\">\r\n            <ContentTemplate>\r\n                <uc2:SubjectChecking ID=\"uSubjectChecking\" runat=\"server\" Visible=\"false\" />\r\n            </ContentTemplate>\r\n        </asp:UpdatePanel>\r\n    </div>\r\n</main>\r\n"}}]}}
