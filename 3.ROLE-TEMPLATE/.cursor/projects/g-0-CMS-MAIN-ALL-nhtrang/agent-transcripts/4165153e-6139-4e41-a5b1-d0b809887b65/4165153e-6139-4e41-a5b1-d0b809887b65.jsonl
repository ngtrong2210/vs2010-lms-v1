{"role":"assistant","message":{"content":[{"type":"text","text":"[REDACTED]"},{"type":"tool_use","name":"Write","input":{"path":"g:\\0.CMS-MAIN-ALL\\nhtrang\\tuyensinh-nhatrang\\Controls\\HeaderNew.ascx","contents":"<%@ Control Language=\"C#\" AutoEventWireup=\"true\" CodeBehind=\"HeaderNew.ascx.cs\" Inherits=\"InformationWeb.Controls.HeaderNew\" %>\n<%@ Register Src=\"~/Controls/Language.ascx\" TagPrefix=\"uc\" TagName=\"Language\" %>\n<%@ Register Src=\"~/Controls/MenuBootstrap_Edu.ascx\" TagPrefix=\"uc\" TagName=\"MenuBootstrapEdu\" %>\n\n<!-- Start sidebar widget content -->\n<div class=\"xs-sidebar-group info-group info-sidebar\">\n    <div class=\"xs-overlay xs-bg-black\"></div>\n    <div class=\"xs-sidebar-widget\">\n        <div class=\"sidebar-widget-container\">\n            <div class=\"widget-heading\">\n                <a href=\"#\" class=\"close-side-widget\">X</a>\n            </div>\n            <div class=\"sidebar-textwidget\">\n                <div class=\"sidebar-info-contents\">\n                    <div class=\"content-inner\">\n                        <div class=\"logo\">\n                            <a href=\"<%= GetHomeUrl() %>\">\n                                <img src=\"/Media/m-logo-cnnqunantri.jpg\" alt=\"<%= InformationWeb.ResManager.GetString(\"Header_LogoAlt\") %>\" /></a>\n                        </div>\n                        <div class=\"content-box\">\n                            <h4><%= InformationWeb.ResManager.GetString(\"Header_Intro\") %></h4>\n                            <div class=\"inner-text\">\n                                <p><%= InformationWeb.ResManager.GetString(\"Header_AboutText\") %></p>\n                            </div>\n                        </div>\n                        <div class=\"sidebar-contact-info\">\n                            <h4><%= InformationWeb.ResManager.GetString(\"ContactUs\") %></h4>\n                            <ul class=\"list-unstyled\">\n                                <li>\n                                    <span class=\"far fa-phone\"></span>\n                                    <a href=\"tel:02323836140\">(0232) 3836140</a>\n                                </li>\n                                <li>\n                                    <span class=\"fal fa-envelope\"></span>\n                                    <a href=\"mailto:vanphong.ktcnnqb@gmail.com\">vanphong.ktcnnqb@gmail.com</a>\n                                </li>\n                                <li>\n                                    <span class=\"far fa-clock\"></span>\n                                    <%= InformationWeb.ResManager.GetString(\"Top_WorkingHours\") %>\n                                </li>\n                            </ul>\n                        </div>\n                        <div class=\"thm-social-link1\">\n                            <ul class=\"social-box list-unstyled\">\n                                <li>\n                                    <a href=\"https://www.facebook.com/\" target=\"_blank\" rel=\"noopener\"><i class=\"fab fa-facebook-f\"></i></a>\n                                </li>\n                                <li>\n                                    <a href=\"https://www.youtube.com/\" target=\"_blank\" rel=\"noopener\"><i class=\"fab fa-youtube\"></i></a>\n                                </li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- End sidebar widget content -->\n\n<header class=\"main-header-two\">\n    <div class=\"main-menu-two__top\">\n        <div class=\"main-menu-two__top-inner\">\n            <ul class=\"list-unstyled main-menu-two__contact-list\">\n                <li>\n                    <div class=\"icon\">\n                        <i class=\"fal fa-envelope\"></i>\n                    </div>\n                    <div class=\"text\">\n                        <p><a href=\"mailto:vanphong.ktcnnqb@gmail.com\">vanphong.ktcnnqb@gmail.com</a></p>\n                    </div>\n                </li>\n                <li>\n                    <div class=\"icon\">\n                        <i class=\"far fa-phone\"></i>\n                    </div>\n                    <div class=\"text\">\n                        <p><a href=\"tel:02323836140\">(0232) 3836140</a></p>\n                    </div>\n                </li>\n                <li>\n                    <div class=\"icon\">\n                        <i class=\"far fa-clock\"></i>\n                    </div>\n                    <div class=\"text\">\n                        <p><%= InformationWeb.ResManager.GetString(\"Top_WorkingHours\") %></p>\n                    </div>\n                </li>\n            </ul>\n            <p class=\"main-menu-two__top-welcome-text d-none d-xl-block\">\n                <%= InformationWeb.ResManager.GetString(\"Header_SchoolName_Line1_Desktop\") %>\n                <%= InformationWeb.ResManager.GetString(\"Header_SchoolName_Line2_Desktop\") %>\n            </p>\n            <div class=\"main-menu-two__top-right\">\n                <ul class=\"list-unstyled header-top-language mb-0\">\n                    <uc:Language ID=\"Language1\" runat=\"server\" />\n                </ul>\n                <p class=\"main-menu-two__social-title\"><%= InformationWeb.ResManager.GetString(\"Header_Connect\") %>:</p>\n                <div class=\"main-menu-two__social\">\n                    <a href=\"https://www.facebook.com/\" target=\"_blank\" rel=\"noopener\"><i class=\"fab fa-facebook-f\"></i></a>\n                    <a href=\"https://www.youtube.com/\" target=\"_blank\" rel=\"noopener\"><i class=\"fab fa-youtube\"></i></a>\n                </div>\n            </div>\n        </div>\n    </div>\n    <nav class=\"main-menu main-menu-two\">\n        <div class=\"main-menu-two__wrapper\">\n            <div class=\"main-menu-two__wrapper-inner\">\n                <div class=\"main-menu-two__left\">\n                    <div class=\"main-menu-two__logo\">\n                        <a href=\"<%= GetHomeUrl() %>\">\n                            <img src=\"/Media/m-logo-cnnqunantri.jpg\" alt=\"<%= InformationWeb.ResManager.GetString(\"Header_LogoAlt\") %>\" /></a>\n                    </div>\n                </div>\n                <div class=\"main-menu-two__main-menu-box\">\n                    <a href=\"#\" class=\"mobile-nav__toggler\"><i class=\"fa fa-bars\"></i></a>\n                    <uc:MenuBootstrapEdu ID=\"MenuBootstrapEduDesktop\" runat=\"server\" />\n                </div>\n                <div class=\"main-menu-two__right\">\n                    <div class=\"main-menu-two__search-cart-box\">\n                        <div class=\"main-menu-two__search-box\">\n                            <a href=\"#\" class=\"main-menu-two__search searcher-toggler-box icon-search-interface-symbol\" aria-label=\"<%= InformationWeb.ResManager.GetString(\"Header_SearchWhat\") %>\"></a>\n                        </div>\n                    </div>\n                    <div class=\"main-menu-two__nav-sidebar-icon\">\n                        <a class=\"navSidebar-button\" href=\"#\">\n                            <span class=\"icon-dots-menu-one\"></span>\n                            <span class=\"icon-dots-menu-two\"></span>\n                            <span class=\"icon-dots-menu-three\"></span>\n                        </a>\n                    </div>\n                    <div class=\"main-menu-two__btn-box\">\n                        <a href=\"<%= GetRegisterUrl() %>\" class=\"thm-btn\"><%= InformationWeb.ResManager.GetString(\"InfoSec_Common_RegisterNowUpper\") %><span class=\"fas fa-arrow-right\"></span></a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </nav>\n</header>\n\n<div class=\"stricky-header stricked-menu main-menu main-menu-two\">\n    <div class=\"sticky-header__content\"></div>\n</div>\n\n<div class=\"mobile-nav__wrapper\">\n    <div class=\"mobile-nav__overlay mobile-nav__toggler\"></div>\n    <div class=\"mobile-nav__content\">\n        <span class=\"mobile-nav__close mobile-nav__toggler\"><i class=\"fa fa-times\"></i></span>\n        <div class=\"logo-box\">\n            <a href=\"<%= GetHomeUrl() %>\" aria-label=\"logo image\">\n                <img src=\"/Media/m-logo-cnnqunantri.jpg\" width=\"150\" alt=\"<%= InformationWeb.ResManager.GetString(\"Header_LogoAlt\") %>\" /></a>\n        </div>\n        <div class=\"mobile-nav__container\"></div>\n        <ul class=\"mobile-nav__contact list-unstyled\">\n            <li>\n                <i class=\"fa fa-envelope\"></i>\n                <a href=\"mailto:vanphong.ktcnnqb@gmail.com\">vanphong.ktcnnqb@gmail.com</a>\n            </li>\n            <li>\n                <i class=\"fas fa-phone\"></i>\n                <a href=\"tel:02323836140\">(0232) 3836140</a>\n            </li>\n        </ul>\n        <div class=\"mobile-nav__top\">\n            <div class=\"mobile-nav__social\">\n                <a href=\"https://www.facebook.com/\" target=\"_blank\" rel=\"noopener\" class=\"fab fa-facebook-f\"></a>\n                <a href=\"https://www.youtube.com/\" target=\"_blank\" rel=\"noopener\" class=\"fab fa-youtube\"></a>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div class=\"search-popup\">\n    <div class=\"color-layer\"></div>\n    <button type=\"button\" class=\"close-search\"><span class=\"far fa-times fa-fw\"></span></button>\n    <div class=\"search-modal-form\" data-search-url=\"<%= GetGlobalSearchUrl() %>\">\n        <div class=\"form-group\">\n            <input type=\"search\" id=\"headerSearchKeyword\" name=\"keyword\" value=\"\" placeholder=\"<%= InformationWeb.ResManager.GetString(\"Header_SearchWhat\") %>\" aria-label=\"<%= InformationWeb.ResManager.GetString(\"Header_SearchWhat\") %>\" />\n            <button type=\"button\" onclick=\"submitGlobalHeaderSearch('headerSearchKeyword', this);\"><i class=\"fas fa-search\"></i></button>\n        </div>\n    </div>\n</div>\n\n<style>\n    .header-top-language\n    {\n        position: relative;\n        display: flex;\n        align-items: center;\n        margin-right: 18px;\n    }\n    .header-top-language .language-switch\n    {\n        margin-bottom: 0;\n    }\n    .header-top-language .lang-current\n    {\n        color: #ffffff;\n    }\n    .header-top-language .lang-current span\n    {\n        color: #ffffff !important;\n    }\n    .header-top-language .lang-current i\n    {\n        color: #ffffff !important;\n    }\n    .main-menu-two__logo img\n    {\n        max-height: 90px;\n        width: auto;\n    }\n    .mobile-nav__wrapper .logo-box img\n    {\n        max-height: 90px;\n        width: auto;\n    }\n    @media (max-width: 1199px)\n    {\n        .main-menu-two__top-welcome-text\n        {\n            display: none !important;\n        }\n    }\n    @media (max-width: 767px)\n    {\n        .main-menu-two__top-inner\n        {\n            justify-content: center;\n        }\n        .main-menu-two__contact-list\n        {\n            flex-wrap: wrap;\n            justify-content: center;\n        }\n        .main-menu-two__contact-list li + li\n        {\n            margin-left: 20px;\n        }\n        .main-menu-two__contact-list li:before\n        {\n            left: -10px;\n        }\n        .main-menu-two__top-right\n        {\n            justify-content: center;\n            width: 100%;\n            margin-top: 8px;\n        }\n    }\n</style>\n<script type=\"text/javascript\">\n    (function () {\n        function getCanonicalSearchPath() {\n            var path = (window.location && window.location.pathname) ? window.location.pathname.toLowerCase() : \"\";\n            return path.indexOf(\"/en/\") === 0 ? \"/en/tim-kiem\" : \"/tim-kiem\";\n        }\n\n        function normalizeSearchUrl(url) {\n            var searchUrl = url || \"\";\n            searchUrl = searchUrl.replace(/\\/Default\\.aspx$/i, \"\");\n            searchUrl = searchUrl.replace(/\\/Default\\.aspx\\?/i, \"/?\");\n            searchUrl = searchUrl.replace(/\\/Pages\\/InfomationNew\\/Search\\.aspx$/i, \"\");\n            searchUrl = searchUrl.replace(/\\/Pages\\/InfomationNew\\/Search\\.aspx\\?/i, \"/?\");\n\n            if (!searchUrl || searchUrl === \"/\") {\n                searchUrl = getCanonicalSearchPath();\n            }\n\n            if (searchUrl.charAt(0) !== \"/\") {\n                searchUrl = \"/\" + searchUrl;\n            }\n\n            return searchUrl;\n        }\n\n        function getSearchUrl(inputId) {\n            var input = document.getElementById(inputId);\n            if (!input) return null;\n\n            var root = input.parentNode;\n            while (root && (!root.getAttribute || !root.getAttribute(\"data-search-url\"))) {\n                root = root.parentNode;\n            }\n\n            return root ? root.getAttribute(\"data-search-url\") : null;\n        }\n\n        function navigateSearch(inputId) {\n            var input = document.getElementById(inputId);\n            if (!input) return false;\n\n            var searchUrl = getSearchUrl(inputId);\n            if (!searchUrl) return false;\n            searchUrl = normalizeSearchUrl(searchUrl);\n\n            var keyword = input.value ? input.value.replace(/^\\s+|\\s+$/g, \"\") : \"\";\n            var targetUrl = searchUrl;\n            if (keyword.length > 0) {\n                targetUrl += (targetUrl.indexOf(\"?\") >= 0 ? \"&\" : \"?\") + \"keyword=\" + encodeURIComponent(keyword);\n            }\n\n            window.location.href = targetUrl;\n            return false;\n        }\n\n        window.submitGlobalHeaderSearch = function (inputId) {\n            return navigateSearch(inputId);\n        };\n\n        function bindEnter(inputId) {\n            var input = document.getElementById(inputId);\n            if (!input) return;\n\n            input.onkeydown = function (event) {\n                event = event || window.event;\n                var keyCode = event.which || event.keyCode;\n                if (keyCode === 13) {\n                    if (event.preventDefault) event.preventDefault();\n                    event.returnValue = false;\n                    navigateSearch(inputId);\n                    return false;\n                }\n                return true;\n            };\n        }\n\n        function initHeaderSearch() {\n            bindEnter(\"headerSearchKeyword\");\n        }\n\n        if (document.addEventListener) {\n            document.addEventListener(\"DOMContentLoaded\", initHeaderSearch);\n        } else if (window.attachEvent) {\n            window.attachEvent(\"onload\", initHeaderSearch);\n        } else {\n            window.onload = initHeaderSearch;\n        }\n    })();\n</script>\n"}}]}}
