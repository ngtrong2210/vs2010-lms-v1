{"role":"assistant","message":{"content":[{"type":"text","text":"Đang đồng bộ UI từ `source mãu` sang `hó/Controls/Acc`, giữ nguyên logic thanh toán hiện tại (VTB QR thay vì VCB).\n\n[REDACTED]"},{"type":"tool_use","name":"TodoWrite","input":{"merge":false,"todos":[{"id":"1","content":"Chuẩn hóa StudentDebt.ascx","status":"in_progress"},{"id":"2","content":"Chuẩn hóa ReceiptList.ascx","status":"pending"},{"id":"3","content":"Chuẩn hóa AddReceipt.ascx","status":"pending"},{"id":"4","content":"Chuẩn hóa QRCode.ascx","status":"pending"},{"id":"5","content":"Chuẩn hóa ReceiptCheckout.ascx (giữ logic VTB)","status":"pending"},{"id":"6","content":"Chuẩn hóa ReceiptResponse_ACB.ascx","status":"pending"}]}},{"type":"tool_use","name":"Write","input":{"path":"g:\\0.DỰ ÁN\\Z.WEB-LONG THANH 1\\hó\\Controls\\Acc\\StudentDebt.ascx","contents":"<%@ Control Language=\"C#\" AutoEventWireup=\"true\" CodeBehind=\"StudentDebt.ascx.cs\"  Inherits=\"InformationWeb.Controls.Acc.StudentDebt\" %>\n\n      <div class=\" table-responsive fs-7 align-middle mt-2 \">     \n    <asp:Repeater runat=\"server\" ID=\"rptList\" >\n        \n        <HeaderTemplate>\n                <table class=\"table table-bordered table-hover \">\n                        <thead class=\"table-primary-2 align-middle text-nowrap\">\n                            <tr class=\"fw-bold\">\n                        <td align=\"center\">TT</td>\n                        <td class='<%= GetCssName(\"YearID\") %>' align=\"center\"><asp:LinkButton runat=\"server\" ID='LinkButton6' OnClick='lbtTitle_Click' CommandArgument='YearID'>Niên học</asp:LinkButton></td>\n                        <td class='<%= GetCssName(\"Semester\") %>' align=\"center\"><asp:LinkButton runat=\"server\" ID='LinkButton9' OnClick='lbtTitle_Click' CommandArgument='Semester'>HK</asp:LinkButton></td>\n                        <td class='<%= GetCssName(\"ReceiptSegmentName\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton2' OnClick='lbtTitle_Click' CommandArgument='ReceiptSegmentName'>Khoản thu</asp:LinkButton></td>\n\n                        <td class='<%= GetCssName(\"PlanMoney\") %>' align=\"center\"><asp:LinkButton runat=\"server\" ID='LinkButton5' OnClick='lbtTitle_Click' CommandArgument='PlanMoney'>Phải đóng</asp:LinkButton></td>\n                        <td class='<%= GetCssName(\"WaitingMoney\") %>' align=\"center\"><asp:LinkButton runat=\"server\" ID='LinkButton3' OnClick='lbtTitle_Click' CommandArgument='WaitingMoney'>Chờ thanh toán...</asp:LinkButton></td>\n                        <td class='<%= GetCssName(\"ReceiptMoney\") %>' align=\"center\"><asp:LinkButton runat=\"server\" ID='LinkButton1' OnClick='lbtTitle_Click' CommandArgument='ReceiptMoney'>Đã đóng</asp:LinkButton></td>                        \n                        <td class='<%= GetCssName(\"RemainMoney\") %>' align=\"center\"><asp:LinkButton runat=\"server\" ID='LinkButton4' OnClick='lbtTitle_Click' CommandArgument='RemainMoney'>Còn nợ</asp:LinkButton></td>\n                        \n                    </tr>\n                    </thead>\n        </HeaderTemplate>\n\n        <ItemTemplate>\n            <tr <%= WriteEventRow() %>>\n                <td align=\"center\" ><%= intRowIndex %></td>\n                <td align=\"center\" >                         \n                    <%#Eval(\"YearText\")%> \n                </td>\n                <td align=\"center\" >                         \n                    <%#Eval(\"Semester\")%> \n                </td>\n                <td>                         \n                    <%#Eval(\"ReceiptSegmentName\")%> \n                </td>\n                \n                <td align=\"right\" >                         \n                    <%# Convert.ToDecimal(Eval(\"PlanMoney\")).ToString(\"#,###\")%> \n                </td>\n                <td align=\"right\" >                         \n                    <%# Convert.ToDecimal(Eval(\"WaitingMoney\")).ToString(\"#,###\")%> \n                </td>                    \n                <td align=\"right\" >                         \n                    <%# Convert.ToDecimal(Eval(\"ReceiptMoney\")).ToString(\"#,###\")%> \n                </td>\n                <td align=\"right\" style='color:Red;' >                         \n                    <%# Convert.ToDecimal(Eval(\"RemainMoney\")).ToString(\"#,###\")%> \n                </td>                \n            </tr>\n        </ItemTemplate>\n\n            <FooterTemplate>\n                </table>\n            </FooterTemplate>\n\n    </asp:Repeater>\n     </div>           \n\n    <div style=\"width:100%; float:left; background-color:#FFFFCC; color:#3333CC; font-size:16px;\" class=\"p-2\">\n        Tổng tiền cần đóng: <b><asp:Label runat=\"server\" ID=\"lblPlanMoney\"></asp:Label></b> &nbsp; &nbsp;\n        Chờ thanh toán: <b><asp:Label runat=\"server\" ID=\"lblWaitingMoney\" ForeColor=\"Green\"></asp:Label> </b> &nbsp; &nbsp;   \n        Đã đóng: <b><asp:Label runat=\"server\" ID=\"lblReceiptMoney\" ForeColor=\"#ef00ff\"></asp:Label> </b> &nbsp; &nbsp;\n        Còn nợ: <b><asp:Label runat=\"server\" ID=\"lblRemainMoney\" ForeColor=\"Red\"></asp:Label> </b>     \n    </div>\n\n   \n"}},{"type":"tool_use","name":"Write","input":{"path":"g:\\0.DỰ ÁN\\Z.WEB-LONG THANH 1\\hó\\Controls\\Acc\\ReceiptList.ascx","contents":"<%@ Control Language=\"C#\" AutoEventWireup=\"true\" CodeBehind=\"ReceiptList.ascx.cs\"  Inherits=\"InformationWeb.Controls.Acc.ReceiptList\" %>\n<%@ Register src=\"../Sims/UYearSemester2.ascx\" tagname=\"UYearSemester2\" tagprefix=\"uc1\" %>\n<%@ Register src=\"StudentDebt.ascx\" tagname=\"StudentDebt\" tagprefix=\"uc2\" %>\n<main class=\" users \" id=\"skip-target\">\n   <div class=\"container-fluid\">\n      <h2 class=\"main-title ms-1\" style=\"display: flex\">\n         <span class=\"  icon svg-hphi-1\" aria-hidden=\"true\">\n         </span>\n         THÔNG TIN THANH TOÁN HỌC PHÍ\n      </h2>\n        \n <div class=\"container p-0\"> \n    <div class=\"row\">        \n        <asp:UpdatePanel ID=\"udpCommand\" runat=\"server\" UpdateMode=\"Conditional\">\n            <ContentTemplate>  \n                <div style='float:right'>                \n                    <asp:Button ID=\"btnSearch\" runat=\"server\" CssClass=\"bt-search-6 bo-radius-1 mx-2\" \n                          Text=\"Nạp lại\" onclick=\"btnSearch_Click\" />    \n                     <asp:Button ID=\"btnAddReceipt\" runat=\"server\" CssClass=\"bt-search-9 bo-radius-1 mx-2\" \n                          Text=\"Lập lệnh thanh toán\" onclick=\"btnAddReceipt_Click\"/>                                                                 \n                </div>\n            </ContentTemplate>\n        </asp:UpdatePanel>\n    </div>       \n    \n    <div class=\"row mt-2\" style='font-weight:bold;color:Red' >THÔNG TIN CÔNG NỢ</div>\n    <div class=\"row\">\n\n        <asp:UpdatePanel ID=\"udpStudentDebt\" runat=\"server\" UpdateMode=\"Conditional\">\n            <ContentTemplate>\n                \n                <uc2:StudentDebt ID=\"uStudentDebt\" runat=\"server\" />\n                \n            </ContentTemplate>\n        </asp:UpdatePanel>\n    </div>\n\n\n    <div class=\"row  my-2 mt-4 \" style='font-weight:bold;color:Red'>LỊCH SỬ ĐÓNG TIỀN</div>\n    <div class=\"\">\n        <div class=\" table-responsive fs-7 align-middle mt-2 \">     \n        <asp:UpdatePanel ID=\"udpList\" runat=\"server\" UpdateMode=\"Conditional\">\n            <ContentTemplate>\n                \n                <asp:Repeater runat=\"server\" ID=\"rptList\" >\n        \n                    <HeaderTemplate>\n                            <table class=\"table table-bordered table-hover \">\n                        <thead class=\"table-primary-2 align-middle text-nowrap\">\n                            <tr class=\"fw-bold\">\n                                    <td align=\"center\">TT</td>\n                                    <td class='<%= GetCssName(\"ReceiptNo\") %>' align=\"center\"><asp:LinkButton runat=\"server\" ID='LinkButton2' OnClick='lbtTitle_Click' CommandArgument='ReceiptNo'>Số biên lai</asp:LinkButton></td>\n                                    <td class='<%= GetCssName(\"ReceiptDate\") %>' align=\"center\"><asp:LinkButton runat=\"server\" ID='LinkButton3' OnClick='lbtTitle_Click' CommandArgument='ReceiptDate'>Ngày biên lai</asp:LinkButton></td>\n                                    <td class='<%= GetCssName(\"Money\") %>' align=\"center\"><asp:LinkButton runat=\"server\" ID='LinkButton5' OnClick='lbtTitle_Click' CommandArgument='Money'>Số tiền</asp:LinkButton></td>                  \n                                    <td class='<%= GetCssName(\"Reason\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton1' OnClick='lbtTitle_Click' CommandArgument='Reason'>Nội dung</asp:LinkButton></td>\n                                    <td class='<%= GetCssName(\"PaymentMethodName\") %>' align=\"center\"><asp:LinkButton runat=\"server\" ID='LinkButton7' OnClick='lbtTitle_Click' CommandArgument='PaymentMethodName'>Hình thức thanh toán</asp:LinkButton></td>\n                                    <td class='<%= GetCssName(\"PaymentStatusName\") %>' align=\"center\"><asp:LinkButton runat=\"server\" ID='LinkButton8' OnClick='lbtTitle_Click' CommandArgument='PaymentStatusName'>Trạng thái thanh toán</asp:LinkButton></td>\n                                    <td class='<%= GetCssName(\"CreatedDate\") %>' align=\"center\"><asp:LinkButton runat=\"server\" ID='LinkButton4' OnClick='lbtTitle_Click' CommandArgument='CreatedDate'>Ngày giờ tạo</asp:LinkButton></td>                                    \n                                    <td style=\"width:20px\"></td>\n                                    <%--<td><asp:LinkButton runat=\"server\" ID='LinkButton4' OnClientClick='return CheckingAllClick();' CommandArgument='Checking'>Điểm danh tất cả</asp:LinkButton></td>--%>                                   \n                                </tr>\n                                </thead>\n                    </HeaderTemplate>\n\n                    <ItemTemplate>\n                        <tr <%= WriteEventRow() %>>\n                            <td align=\"center\" ><%= intRowIndex %></td>\n                            <td align=\"center\" >                         \n                                <%#Eval(\"ReceiptNo\")%> \n                            </td>\n                            <td align=\"center\" >                         \n                                <%# Eval(\"ReceiptDate\",\"{0:dd/MM/yyyy}\") %>    \n                            </td>\n                            <td align=\"right\" >                         \n                                <%# Convert.ToDecimal(Eval(\"TotalMoney\")).ToString(\"#,###\")%> \n                            </td>\n\n                            <td >\n                                <%# Eval(\"Reason\")%> \n                            </td>\n                            <td align=\"center\">\n                                <%# Eval(\"PaymentMethodName\")%> \n                            </td>\n                             <td align=\"center\" >\n                                <%# Eval(\"PaymentStatusName_Format\")%>\n                                 <%# Eval(\"IsLockedText\")%>\n                            </td>\n                            <td align=\"center\" >                         \n                                 <%# Eval(\"CreatedDate\", \"{0:dd/MM/yyyy HH:mm:ss}\")%>  \n                            </td>                                                     \n                            <td align=\"center\" >               \n                                \n                                <asp:LinkButton runat=\"server\" ID=\"lbtDetail\" OnClick='lbtDetail_Click' CssClass='ViewBtn' ToolTip=\"Chi tiết lệnh/biên lai\"                                                                         \n                                    CommandArgument='<%# Eval(\"ReceiptID\") %>'>\n                                </asp:LinkButton> &nbsp;\n\n                                <asp:LinkButton runat=\"server\" ID=\"lbtDelete\" OnClick='lbtDelete_Click' CssClass='DeleteBtn'  ToolTip=\"Xóa lệnh giao dịch\"                                    \n                                    Visible='<%# Eval(\"AllowDelete\")  %>' \n                                    CommandArgument='<%# Eval(\"ReceiptID\") %>' OnClientClick=\"return confirm('Bạn có chắc chắn là muốn xóa lệnh giao dịch này?');\">\n                                </asp:LinkButton> &nbsp;\n                            </td>                                                       \n                        </tr>\n                    </ItemTemplate>\n\n                        <FooterTemplate>\n                            </table>\n                        </FooterTemplate>\n\n                </asp:Repeater>                \n                 \n                <div style=\"width:100%; float:left; background-color:#FFFFCC; color:#3333CC; font-size:16px\" class=\"p-2\">\n                    Tổng số tiền: <b><asp:Label runat=\"server\" ID=\"lblTotalMoney\"></asp:Label></b> &nbsp; &nbsp;\n                    Đã thanh toán: <b><asp:Label runat=\"server\" ID=\"lblTotalReceiptMoney\" ForeColor=\"#ef00ff\"></asp:Label> </b> &nbsp; &nbsp;\n                    Chờ thanh toán: <b><asp:Label runat=\"server\" ID=\"lblTotalWaitingMoney\" ForeColor=\"Green\"></asp:Label> </b>\n                </div>\n                <div style=\"color: #e16800; font-style: italic; padding-top:10px; float:left;\">\n                    *) Lưu ý: Các lệnh quá thời hạn 10 phút chưa hoàn tất thanh toán sẽ tự động được xóa!\n                </div>\n\n            </ContentTemplate>\n        </asp:UpdatePanel>\n            </div>\n    </div>\n\n</div>\n  </div>\n\n</main>\n"}},{"type":"tool_use","name":"Write","input":{"path":"g:\\0.DỰ ÁN\\Z.WEB-LONG THANH 1\\hó\\Controls\\Acc\\AddReceipt.ascx","contents":"<%@ Control Language=\"C#\" AutoEventWireup=\"true\" CodeBehind=\"AddReceipt.ascx.cs\"  Inherits=\"InformationWeb.Controls.Acc.AddReceipt\" %>\n\n\n<main class=\" users \" id=\"skip-target\">\n   <div class=\"container-fluid\">\n      <h2 class=\"main-title ms-1\" style=\"display: flex\">\n         <span class=\"  icon svg-hphi-1\" aria-hidden=\"true\">\n         </span>\n         Lập lệnh nộp tiền mới\n      </h2>\n<div class=\"container p-0\" style=\"margin-top:20px;\" >  \n    <div class=\"\">   \n           <div class=\" table-responsive fs-7 align-middle mt-2 \">   \n        <asp:UpdatePanel ID=\"udpList\" runat=\"server\" UpdateMode=\"Conditional\">\n            <ContentTemplate>\n                \n                <asp:Repeater runat=\"server\" ID=\"rptList\" >\n        \n                    <HeaderTemplate>\n                           <table class=\"table table-bordered table-hover \">\n                        <thead class=\"table-primary-2 align-middle text-wrap\">\n                            <tr class=\"fw-bold\">\n                                    <td align=\"center\">TT</td>\n                                    <td align=\"center\">Niên học</td>\n                                    <td align=\"center\">HK</td>\n                                    <td>Nội dung</td>\n                                    <td align=\"center\">Số tiền nợ</td>\n                                    <td align=\"center\" style='max-width:80px'>Chọn khoản cần nộp</td>                                                                        \n                                </tr>\n                                </thead>\n                    </HeaderTemplate>\n\n                    <ItemTemplate>\n                        <tr <%= WriteEventRow() %>>\n                            <td align=\"center\"  class=\"py-2\"><%= intRowIndex %></td>\n                            <td align=\"center\" >                         \n                                <%#Eval(\"YearText\")%> \n                            </td>\n                            <td align=\"center\" >                         \n                                <%#Eval(\"Semester\")%> \n                            </td>\n                            <td>                         \n                                <%#Eval(\"ReceiptSegmentName\")%> \n                            </td>\n                \n                            <td align=\"right\" >                         \n                                <%# Convert.ToDecimal(Eval(\"RemainMoney\")).ToString(\"#,###\")%> \n                            </td>\n                            <td align=\"center\" class=\"text-nowrap text-center align-middle\" >                         \n                                <%--<telerik:RadNumericTextBox ID=\"txtMoney\" runat=\"server\" Value='<%# ToDouble(Eval(\"Money\"))%>' AutoCompleteType=\"None\"                                 \n                                     EnabledStyle-HorizontalAlign=\"Right\" EnabledStyle-Font-Size=\"Large\"\n                                     TabIndex=\"1\"  MaxLength=\"10\" MaxValue='<%# ToDouble(Eval(\"RemainMoney\"))%>' MinValue=\"0\" Width=\"98%\"  AllowOutOfRangeAutoCorrect=\"False\" BackColor=\"White\" BorderStyle=\"Solid\">\n                                    <NumberFormat DecimalDigits=\"0\" />\n                                    <IncrementSettings InterceptArrowKeys=\"False\" InterceptMouseWheel=\"false\" />\n                                </telerik:RadNumericTextBox> --%>\n\n                                <span style='background-color: #d2e6ff; padding: 2px 15px 2px 15px; border-radius: 5px;'>\n                                    <asp:CheckBox runat=\"server\" ID=\"chkIsSelected\" Checked=\"true\"  Text=\" &nbsp; &nbsp; Chọn\" />\n                                </span>\n\n                                <asp:HiddenField runat=\"server\" ID=\"hidRemainMoney\" Value='<%# Eval(\"RemainMoney\") %>' />\n                                <asp:HiddenField runat=\"server\" ID=\"hidReceiptSegmentID\" Value='<%# Eval(\"ReceiptSegmentID\") %>' />\n                            </td>                    \n                        </tr>\n                    </ItemTemplate>\n\n                        <FooterTemplate>\n                            </table>\n                        </FooterTemplate>\n\n                </asp:Repeater>                \n\n                <div style=\"width:100%; float:left; background-color:#FFFFCC; color:#3333CC; font-size:16px; \" class=\"p-2 mb-3\">\n                    Tổng cộng: <b><asp:Label runat=\"server\" ID=\"lblRemainMoney\" Text=\"0\"></asp:Label></b>\n                    <span style='display:none'>\n                    \n                     &nbsp;  &nbsp;  &nbsp; \n                    Tổng tiền muốn nộp: <b><asp:Label runat=\"server\" ID=\"lblTotalMoney\" Text=\"0\"></asp:Label></b> &nbsp; &nbsp; \n                    <b><asp:LinkButton runat=\"server\" ID=\"lblReTotal\" Text=\"Tính lại tổng tiền\" onclick=\"lblReTotal_Click\" CssClass=\"simple-btn\"></asp:LinkButton></b>\n                   \n                    </span>\n\n                    <asp:HiddenField runat=\"server\" ID=\"hidTotalMoney\" />\n                    <asp:HiddenField runat=\"server\" ID=\"hidReason\" />\n                </div>\n\n\n             </ContentTemplate>\n         </asp:UpdatePanel>\n           </div>\n         <asp:UpdatePanel ID=\"udpCommand\" runat=\"server\" UpdateMode=\"Conditional\">\n             <ContentTemplate>\n                \n                    <asp:Button runat=\"server\" ID=\"btnBack\" Text=\"Trở về\" OnClientClick='window.history.back(); return false;' \n                        CssClass=\"bt-search-6 bo-radius-1 mx-2\"  /> &nbsp;\n\n                    <asp:Button runat=\"server\" ID=\"btnNext\" Text=\"Tiếp tục\" \n                        CssClass='bt-search-9 bo-radius-1 mx-2' onclick=\"btnNext_Click\"/>   \n\n\n                        <b><asp:Label runat=\"server\" ID=\"lblResult\" ForeColor=\"Red\"> </asp:Label></b><br /><br />\n\n             </ContentTemplate>\n         </asp:UpdatePanel>\n\n    </div>    \n</div>\n\n</div>\n</main>\n"}},{"type":"tool_use","name":"Write","input":{"path":"g:\\0.DỰ ÁN\\Z.WEB-LONG THANH 1\\hó\\Controls\\Acc\\QRCode.ascx","contents":"<%@ Control Language=\"C#\" AutoEventWireup=\"true\" CodeBehind=\"QRCode.ascx.cs\"  Inherits=\"InformationWeb.Controls.Acc.QRCode\" %>\n   <div class=\"container my-4 mb-5\" style=\"font-family: Arial, sans-serif; font-size:14px; line-height:22px;\">\n    <!-- Header -->\n    <div class=\"text-center mb-4\">\n        <h4 class=\"fw-bold text-danger mb-2\">QUÉT MÃ QR ĐỂ TIẾN HÀNH THANH TOÁN</h4>\n        <p class=\"fst-italic text-purple\" style=\"color:#CC0099;\">\n            \"Vui lòng không đóng trình duyệt trong suốt quá trình thanh toán!\"\n        </p>\n    </div>\n\n    <!-- Thông tin thanh toán -->\n    <div class=\"card shadow-sm border-0 mb-4\">\n        <div class=\"card-header bg-primary text-white fw-bold bi bi-credit-card\">\n            Thông tin thanh toán\n        </div>\n        <div class=\"card-body\">\n            <div class=\"row g-3\">\n                <div class=\"col-md-6\">\n                    <div class=\"row mb-2\">\n                        <label class=\"col-4 fw-semibold\">Số bill:</label>\n                        <div class=\"col-8\"><b><asp:Label runat=\"server\" ID=\"lblReceiptID\"></asp:Label></b></div>\n                    </div>\n                    <div class=\"row mb-2\">\n                        <label class=\"col-4 fw-semibold\">Ngày tạo:</label>\n                        <div class=\"col-8\"><b><asp:Label runat=\"server\" ID=\"lblCreatedDate\"></asp:Label></b></div>\n                    </div>\n                    <div class=\"row mb-2\">\n                        <label class=\"col-4 fw-semibold\">Tổng tiền:</label>\n                        <div class=\"col-8\">\n                            <b><asp:Label runat=\"server\" ID=\"lblTotalMoney\" ForeColor=\"Blue\"></asp:Label></b> VND\n                        </div>\n                    </div>\n                    <div class=\"row mb-2\">\n                        <label class=\"col-4 fw-semibold\">Nội dung:</label>\n                        <div class=\"col-8\"><b><asp:Label runat=\"server\" ID=\"lblReason\"></asp:Label></b></div>\n                    </div>\n                    <div class=\"row mb-2\">\n                        <label class=\"col-4 fw-semibold\">Trạng thái:</label>\n                        <div class=\"col-8\">\n                            <asp:UpdatePanel ID=\"udpCommand\" runat=\"server\" UpdateMode=\"Conditional\">\n                                <ContentTemplate>\n                                    <b><asp:Label runat=\"server\" ID=\"lblPaymentStatusName\" ForeColor=\"Blue\"></asp:Label></b>\n                                    <div class=\"mt-2\">\n                                        <asp:Button runat=\"server\" ID=\"btnRefreshStatus\" Text=\"Kiểm tra trạng thái thanh toán\"\n                                            CssClass=\"btn btn-outline-primary btn-sm rounded-3\"\n                                            OnClick=\"btnRefreshStatus_Click\" />\n                                    </div>\n                                </ContentTemplate>\n                            </asp:UpdatePanel>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- QR hiển thị bên phải -->\n                <div class=\"col-md-6 text-center\">\n                    <asp:UpdatePanel ID=\"udpResult\" runat=\"server\" UpdateMode=\"Conditional\">\n                        <ContentTemplate>\n                            <div class=\"border rounded-3 p-3 bg-light\">\n                                <asp:Image runat=\"server\" ID=\"imgQR\" CssClass=\"img-fluid mb-3 QRImage\" Style=\"max-width: 220px;\" />\n                                <div class=\"mb-2\">\n                                    <a runat=\"server\" id=\"linkDownload\" download=\"QRCode.j