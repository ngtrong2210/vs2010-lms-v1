ectReportEdit_Click\">\n                            <i class=\"bi bi-file-text\"></i> Báo cáo giảng dạy\n                        </asp:LinkButton>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"card-body p-0\">\n            <asp:UpdatePanel ID=\"udpList\" runat=\"server\" UpdateMode=\"Conditional\">\n                <ContentTemplate>\n                    <div class=\"table-responsive\">\n                        <asp:Repeater runat=\"server\" ID=\"rptList\" \n                            onitemdatabound=\"rptList_ItemDataBound\">\n                \n                            <HeaderTemplate>\n                                <table class=\"table table-bordered table-sm align-middle text-center mb-0\">\n                                    <thead>\n                                        <tr class='Header success'>\n                                            <th>TT</th>\n                                            <th class='<%= GetCssName(\"Date\") %>'><asp:LinkButton runat=\"server\" ID='lbtTitle' OnClick='lbtTitle_Click' CommandArgument='Date'>Ngày</asp:LinkButton></th>\n                                            <th class='<%= GetCssName(\"Session\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton6' OnClick='lbtTitle_Click' CommandArgument='Session'>Buổi</asp:LinkButton></th>\n                                            <th class='<%= GetCssName(\"TheoryQuantity\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton1' OnClick='lbtTitle_Click' CommandArgument='TheoryQuantity'>LT</asp:LinkButton></th>\n                                            <th class='<%= GetCssName(\"PracticeQuantity\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton2' OnClick='lbtTitle_Click' CommandArgument='PracticeQuantity'>TH</asp:LinkButton></th>\n                                            <th class='<%= GetCssName(\"TestQuantity\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton4' OnClick='lbtTitle_Click' CommandArgument='TestQuantity'>KT</asp:LinkButton></th>\n                                            <th class='<%= GetCssName(\"OffStudentCount\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton8' OnClick='lbtTitle_Click' CommandArgument='OffStudentCount'>Số HS vắng</asp:LinkButton></th>\n                                            <th class='<%= GetCssName(\"LearningContent\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton3' OnClick='lbtTitle_Click' CommandArgument='LearningContent'>Tóm tắt nội dung bài giảng, kiểm tra</asp:LinkButton></th> \n                                            \n                                            <th>Khoa ký</th> \n                                            <th>GV ký</th> \n                                            <th>Giáo án ký số</th> \n                                            \n                                            <th class='<%= GetCssName(\"RequestContent\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton5' OnClick='lbtTitle_Click' CommandArgument='RequestContent'>Yêu cầu cơ sở vật chất</asp:LinkButton></th>                                     \n                                            <th class='<%= GetCssName(\"Description\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton9' OnClick='lbtTitle_Click' CommandArgument='Description'>Ghi chú</asp:LinkButton></th>\n\n                                            <%-- <td class='<%= GetCssName(\"IsReviewed1\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton7' OnClick='lbtTitle_Click' CommandArgument='IsReviewed1'>Chuyên môn duyệt</asp:LinkButton></td>--%>\n                                            <%--<td class='<%= GetCssName(\"IsReviewed2\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton11' OnClick='lbtTitle_Click' CommandArgument='IsReviewed2'>PCTHS duyệt</asp:LinkButton></td>--%>\n                                            <%-- <td class='<%= GetCssName(\"IsReviewed\") %>'><asp:LinkButton runat=\"server\" ID='LinkButton10' OnClick='lbtTitl