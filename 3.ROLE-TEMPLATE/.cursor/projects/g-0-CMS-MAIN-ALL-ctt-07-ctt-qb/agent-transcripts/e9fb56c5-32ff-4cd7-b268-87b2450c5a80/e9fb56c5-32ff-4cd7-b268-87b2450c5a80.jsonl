gnCA\" runat=\"Server\" OnClick=\"lbtViewSignCA_Click\" Text='' \n                                                ToolTip ='' \n                                                CommandName='<%# Eval(\"Date\") %>'\n                                                CommandArgument='<%# Eval(\"Session\") %>' ForeColor=\"DarkOrange\" >                                        \n                                                Giáo án ký số\n                                        </asp:LinkButton>\n                                    </td>\n\n                                    <td>                         \n                                        <%# Eval(\"RequestContent\")%> \n                                    </td>\n                                                  \n                                    <td>\n                                        <%# Eval(\"Description\")%>                                 \n                                    </td>\n\n                                    <%--<td align=\"center\" >                         \n                                        <%# Eval(\"IsReviewed1Text_Format\")%>     \n                                        <br />\n                                        <asp:Label ID=\"Label1\" runat=\"server\" DataFormatString=\"{0:dd/MM/yyyy}\" Text='<%# Eval(\"ReviewDate1\")%>'></asp:Label><br />\n                                        <b style='font-size:12px'><%# Eval(\"ReviewUser1\")%></b><br />\n                                        <i style='color:Blue'><%# Eval(\"ReviewComment1\")%></i>                                                           \n                                    </td>--%>\n\n                                    <%--<td align=\"center\" >                         \n                                        <%# Eval(\"IsReviewed2Text_Format\")%>     \n                                        <br />\n                                        <asp:Label ID=\"Label3\" runat=\"server\" DataFormatString=\"{0:dd/MM/yyyy}\" Text='<%# Eval(\"ReviewDate2\")%>'></asp:Label><br />\n                                        <b style='font-size:12px'><%# Eval(\"ReviewUser2\")%></b><br />\n                                        <i style='color:Blue'><%# Eval(\"ReviewComment2\")%></i>                                                           \n                                    </td>--%>\n\n                                    <%-- <td align=\"center\" >                         \n                                        <%# Eval(\"IsReviewedText_Format\")%>                                \n                                        <br />\n                                        <asp:Label ID=\"Label2\" runat=\"server\" DataFormatString=\"{0:dd/MM/yyyy}\" Text='<%# Eval(\"ReviewDate\")%>'></asp:Label><br />\n                                        <b style='font-size:12px'><%# Eval(\"ReviewUser\")%></b><br />\n                                        <i style='color:Blue'><%# Eval(\"ReviewComment\")%></i>\n                                    </td>--%>\n\n                                    <td>               \n                                        <asp:HiddenField ID=\"hidTeacherIDOfSchedule\" runat=\"server\" Value='<%# Eval(\"TeacherIDOfSchedule\") %>' />                  \n                                        <asp:HiddenField ID=\"hidTheoryQuantity\" runat=\"server\" Value='<%# Eval(\"TheoryQuantity\") %>' />\n                                        <asp:HiddenField ID=\"hidPracticeQuantity\" runat=\"server\" Value='<%# Eval(\"PracticeQuantity\") %>' />\n                                        <asp:HiddenField ID=\"hidTestQuantity\" runat=\"server\" Value='<%# Eval(\"TestQuantity\") %>' />\n                                        <asp:HiddenField ID=\"hidSession\" runat=\"server\" Value='<%# Eval(\"Session\") %>' />\n\n                                        <asp:LinkButton runat=\"server\" ID=\"lbtEdit\" OnClick='lbtEdit_Click' CssClass='UpdateBtn'                                     \n                                            Visible='<%# AllowEdit(Eval(\"TeacherIDOfSchedule\"), Eval(\"Date\"), Eval(\"IsReviewed1\"), Eval(\"IsReviewed\")) %>' \n                                            CommandName='<%# Eval(\"Date\") %>'                                                                      \n                                            CommandArgument='<%# Eval(\"ScheduleCheckingID\") %>'>\n                                        </asp:LinkButton> &nbsp;\n\n                                        <asp:LinkButton runat=\"server\" ID=\"lbtDelete\" OnClick='lbtDelete_Click' CssClass='DeleteBtn'                                     \n                                            Visible='<%# Eval(\"ScheduleCheckingID\").ToString() != \"\" && AllowEdit(Eval(\"TeacherIDOfSchedule\"), Eval(\"Date\"), Eval(\"IsReviewed1\"), Eval(\"IsReviewed\")) %>' \n                                            CommandName='<%# Eval(\"Date\") %>'                                                                      \n                                            CommandArgument='<%# Eval(\"ScheduleCheckingID\") %>' OnClientClick=\"return confirm('Bạn có chắc chắn là muốn xóa dữ liệu này?');\" >\n                                        </asp:LinkButton><br />\n                                                               \n                                        <asp:LinkButton runat=\"server\" ID=\"lbtSubjectChecking\" OnClick='lbtSubjectChecking_Click' Text='Điểm danh'\n                                            OnClientClick=\"window.location.href = '#SubjectChecking'\"\n                                            Visible='<%# AllowEdit_SubjectChecking(Eval(\"TeacherIDOfSchedule\"), Eval(\"Date\"), Eval(\"IsReviewed2\"), Eval(\"IsReviewed\")) %>' \n                                            CommandName='<%# Eval(\"Date\") %>'\n                                            CommandArgument='<%# Eval(\"Session\") %>'>\n                                        </asp:LinkButton>\n\n                                        <%--<span style='display:none; visibility:hidden'>--%>\n                                        <asp:LinkButton runat=\"server\" ID=\"lbtCopyFromTeachingSchedule\" OnClick='lbtCopyFromTeachingSchedule_Click' CssClass='CopyBtn'                                   \n                                            Visible='<%# AllowCopy(Eval(\"TeacherIDOfSchedule\"), Eval(\"Date\"), Eval(\"ScheduleCheckingID\"), Eval(\"IsReviewed1\"), Eval(\"IsReviewed\")) %>'\n                                            CommandName='<%# Eval(\"Date\") %>'\n                                            CommandArgument='<%# Eval(\"Session\") %>'\n                                            ToolTip=\"Sao chép từ kế hoạch\">\n                                        </asp:LinkButton>\n                                        <%--</span>--%>\n\n                                    </td>\n                                                       \n                                </tr>\n                            </ItemTemplate>\n\n                            <FooterTemplate>\n                                    </tbody>\n                                </table>\n                            </FooterTemplate>\n\n                        </asp:Repeater>\n                    </div>\n                </ContentTemplate>\n            </asp:UpdatePanel>\n        </div>\n        <%--<div class=\"card-footer bg-white border-top\">\n            <div class=\"d-flex align-items-center gap-2 small text-muted\">\n                <i class=\"bi bi-info-circle\"></i> Lưu ý: ...\n            </div>\n        </div>--%>\n    </div>\n\n    \n    <uc3:USignArea ID=\"uSignArea_Popup\" runat=\"server\"  DocFormName = \"TẬP TIN GIÁO ÁN\" IsModal = \"true\" /> <!-- Để ký tập tin giáo án trên từng dòng -->\n    <%--<uc3:USignArea ID=\"uSignArea\" runat=\"server\"  DocFormName = \"SỔ ĐẦU BÀI\"/>--%>  <!-- Của tổng form sổ lên lớp: bản thân control này đã có update panel -->\n\n\n    <