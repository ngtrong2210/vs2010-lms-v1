<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Cms.Master.cs" Inherits="InformationWeb.MasterPages.CmsMaster" %>
<!DOCTYPE html>
<html lang="vi">
    <head runat="server">
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title><%= Server.HtmlEncode(Page.Title) %> - Thiên Hà Số</title>
        <link rel="icon" type="image/png" href="<%= ResolveUrl("~/assets/lms/images/brand/thien-ha-so.png") %>" />
        <link rel="stylesheet" href="<%= ResolveUrl("~/assets/lms/vendor/bootstrap.min.css") %>" />
        <link rel="stylesheet" href="<%= ResolveUrl("~/assets/lms/vendor/bootstrap-icons.min.css") %>" />
        <link rel="stylesheet" href="<%= ResolveUrl("~/assets/lms/css/lms.css") %>" />
        <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
    </head>
    <body class="cms-theme">
        <form id="MainForm" runat="server">
            <asp:ScriptManager ID="MainScriptManager" runat="server" EnablePageMethods="true" />
            <div class="cms-shell cms-theme" data-cms-shell>
                <aside class="lms-sidebar" id="cmsSidebar">
                    <div class="sidebar-header">
                        <a class="sidebar-brand" href="<%= ResolveUrl("~/cms/dashboard") %>" aria-label="Thiên Hà Số">
                            <img src="<%= ResolveUrl("~/assets/lms/images/brand/thien-ha-so.png") %>" alt="" />
                            <span>Thiên Hà Số</span>
                        </a>
                    </div>
                    <nav class="sidebar-content" aria-label="Quản trị">
                        <div class="sidebar-nav-label">Tổng quan</div>
                        <a class="sidebar-nav-item" href="<%= ResolveUrl("~/cms/dashboard") %>">
                            <img src="<%= ResolveUrl("~/assets/lms/icons/solar-bold/widget-5.svg?v=20260901-icons1") %>" alt="" />
                            <span>Bảng điều khiển</span>
                        </a>
                        <div class="sidebar-nav-label">Tổ chức đào tạo</div>
                        <a class="sidebar-nav-item" href="<%= ResolveUrl("~/cms/academic") %>">
                            <img src="<%= ResolveUrl("~/assets/lms/icons/solar-bold/structure.svg?v=20260901-icons1") %>" alt="" />
                            <span>Cơ cấu đào tạo</span>
                        </a>
                        <a class="sidebar-nav-item" href="<%= ResolveUrl("~/cms/courses") %>">
                            <img src="<%= ResolveUrl("~/assets/lms/icons/solar-bold/notebook-bookmark.svg?v=20260901-icons1") %>" alt="" />
                            <span>Soạn môn học lớp</span>
                        </a>
                        <div class="sidebar-nav-label">Học liệu</div>
                        <a class="sidebar-nav-item" href="<%= ResolveUrl("~/cms/videos") %>">
                            <img src="<%= ResolveUrl("~/assets/lms/icons/solar-bold/video-library.svg?v=20260901-icons1") %>" alt="" />
                            <span>Thư viện video</span>
                        </a>
                        <a class="sidebar-nav-item" href="<%= ResolveUrl("~/cms/questions") %>">
                            <img src="<%= ResolveUrl("~/assets/lms/icons/solar-bold/question-square.svg?v=20260901-icons1") %>" alt="" />
                            <span>Ngân hàng câu hỏi</span>
                        </a>
                        <div class="sidebar-nav-label">Học viên</div>
                        <a class="sidebar-nav-item" href="<%= ResolveUrl("~/cms/students") %>">
                            <img src="<%= ResolveUrl("~/assets/lms/icons/solar-bold/users-group-rounded.svg?v=20260901-icons1") %>" alt="" />
                            <span>Danh sách học viên</span>
                        </a>
                        <div class="sidebar-nav-label">Giảng dạy</div>
                        <a class="sidebar-nav-item" href="<%= ResolveUrl("~/cms/assignments") %>">
                            <img src="<%= ResolveUrl("~/assets/lms/icons/solar-bold/clipboard-check.svg?v=20260901-icons1") %>" alt="" />
                            <span>Chấm và trả bài</span>
                        </a>
                        <a class="sidebar-nav-item" href="<%= ResolveUrl("~/cms/reports") %>">
                            <img src="<%= ResolveUrl("~/assets/lms/icons/solar-bold/chart-square.svg?v=20260901-icons1") %>" alt="" />
                            <span>Tiến độ và báo cáo</span>
                        </a>
                        <asp:PlaceHolder ID="AdminMenu" runat="server">
                            <div class="sidebar-nav-label">Hệ thống</div>
                            <a class="sidebar-nav-item" href="<%= ResolveUrl("~/cms/users") %>">
                                <img src="<%= ResolveUrl("~/assets/lms/icons/solar-bold/user-id.svg?v=20260901-icons1") %>" alt="" />
                                <span>Người dùng</span>
                            </a>
                            <a class="sidebar-nav-item" href="<%= ResolveUrl("~/cms/roles") %>">
                                <img src="<%= ResolveUrl("~/assets/lms/icons/solar-bold/shield-user.svg?v=20260901-icons1") %>" alt="" />
                                <span>Phân quyền</span>
                            </a>
                            <a class="sidebar-nav-item" href="<%= ResolveUrl("~/cms/settings") %>">
                                <img src="<%= ResolveUrl("~/assets/lms/icons/solar-bold/settings.svg?v=20260901-icons1") %>" alt="" />
                                <span>Cài đặt</span>
                            </a>
                        </asp:PlaceHolder>
                    </nav>
                </aside>
                <div class="lms-main main-with-sidebar">
                    <header class="lms-header header-with-sidebar">
                        <div class="header-left">
                            <button
                                type="button"
                                class="header-toggle d-lg-none"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#mobileMenu"
                                aria-label="Mở trình đơn"
                            >
                                <i class="bi bi-list"></i>
                            </button>
                            <button
                                type="button"
                                class="header-toggle d-none d-lg-block"
                                data-sidebar-collapse
                                aria-label="Thu gọn thanh menu"
                                title="Thu gọn menu"
                            >
                                <svg class="sidebar-toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="2.75" y="3.25" width="18.5" height="17.5" rx="3"></rect>
                                    <path d="M8.25 3.5v17"></path>
                                    <path class="sidebar-arrow-open" d="m16 8-4 4 4 4"></path>
                                    <path class="sidebar-arrow-closed" d="m12 8 4 4-4 4"></path>
                                </svg>
                            </button>
                            <div>
                                <small class="text-muted">ELEARNING</small>
                                <div data-page-title class="fw-bold">Quản trị</div>
                            </div>
                        </div>
                        <div class="header-right">
                            <a class="header-action-btn d-xl-none" href="<%= ResolveUrl("~/cms/search") %>" aria-label="Tìm kiếm"><i class="bi bi-search"></i></a>
                            <div class="notification-center" data-notification-center data-handler-url="<%= ResolveUrl("~/Handlers/Lms/Module.ashx") %>">
                                <button type="button" class="header-action-btn" data-notification-toggle aria-label="Thông báo">
                                    <i class="bi bi-bell"></i>
                                    <span class="badge-count"><asp:Literal ID="NotificationCountText" runat="server" /></span>
                                </button>
                                <div class="notification-panel" data-notification-panel hidden>
                                    <div class="notification-panel-head">
                                        <strong>Thông báo</strong>
                                        <button type="button" class="btn btn-sm btn-link" data-notification-read-all>Đọc tất cả</button>
                                    </div>
                                    <div data-notification-list class="notification-list">
                                        <span class="text-secondary">Đang tải...</span>
                                    </div>
                                </div>
                            </div>
                            <div class="header-user d-none d-sm-flex">
                                <img class="header-user-avatar" src="<%= ResolveUrl("~/assets/lms/images/avatar-admin.jpg") %>" alt="Ảnh đại diện" />
                                <div class="header-user-info">
                                    <div class="header-user-name"><asp:Literal ID="UserNameText" runat="server" /></div>
                                    <div class="header-user-role">Tài khoản hệ thống</div>
                                </div>
                            </div>
                            <a
                                class="header-action-btn btn-danger"
                                href="<%= ResolveUrl("~/logout") %>"
                                title="Đăng xuất"
                                aria-label="Đăng xuất"
                            >
                                <i class="bi bi-box-arrow-right"></i>
                            </a>
                        </div>
                    </header>
                    <main class="main-content"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
                </div>
                <div id="mobileMenu" class="offcanvas offcanvas-start lms-mobile-sidebar" tabindex="-1">
                    <div class="mobile-sidebar-header">
                        <a class="sidebar-brand" href="<%= ResolveUrl("~/cms/dashboard") %>" aria-label="Thiên Hà Số">
                            <img src="<%= ResolveUrl("~/assets/lms/images/brand/thien-ha-so.png") %>" alt="" />
                            <span>Thiên Hà Số</span>
                        </a>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
                    </div>
                    <div class="mobile-sidebar-body" data-mobile-menu></div>
                </div>
            </div>
            <script src="<%= ResolveUrl("~/assets/lms/vendor/bootstrap.bundle.min.js") %>"></script>
            <script src="<%= ResolveUrl("~/assets/lms/js/app.js?v=20260901-ui5") %>"></script>
            <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
        </form>
    </body>
</html>
