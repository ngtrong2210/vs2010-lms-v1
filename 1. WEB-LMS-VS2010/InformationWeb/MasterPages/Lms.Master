<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Lms.Master.cs" Inherits="InformationWeb.MasterPages.LmsMaster" %>
<!DOCTYPE html>
<html lang="vi">
    <head runat="server">
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title><%= Server.HtmlEncode(Page.Title) %> - Thiên Hà Số</title>
        <link rel="icon" type="image/png" href="<%= ResolveUrl("~/assets/lms/images/brand/thien-ha-so.png") %>" />
        <link rel="stylesheet" href="<%= ResolveUrl("~/assets/lms/vendor/bootstrap.min.css") %>" />
        <link rel="stylesheet" href="<%= ResolveUrl("~/assets/lms/vendor/bootstrap-icons.min.css") %>" />
        <link rel="stylesheet" href="<%= ResolveUrl("~/assets/lms/css/lms.css") %>" />
        <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
    </head>
    <body>
        <form id="MainForm" runat="server">
            <asp:ScriptManager ID="MainScriptManager" runat="server" EnablePageMethods="true" />
            <div class="lms-shell">
                <div class="lms-topbar">
                    <div class="container">
                        <span class="lms-topbar-item">
                            <i class="bi bi-mortarboard"></i>
                            Hệ thống học tập trực tuyến Thiên Hà Số
                        </span>
                        <span class="lms-topbar-item d-none d-md-inline">
                            <i class="bi bi-headset"></i>
                            Hỗ trợ học viên: Bộ phận đào tạo
                        </span>
                    </div>
                </div>
                <header class="lms-header header-no-sidebar">
                    <div class="container">
                        <a class="header-brand" href="<%= ResolveUrl("~/lms/dashboard") %>" aria-label="Thiên Hà Số">
                            <img src="<%= ResolveUrl("~/assets/lms/images/brand/thien-ha-so.png") %>" alt="" />
                            <span>Thiên Hà Số</span>
                        </a>
                        <button
                            type="button"
                            class="header-toggle d-lg-none"
                            data-bs-toggle="collapse"
                            data-bs-target="#lmsNav"
                            aria-label="Mở trình đơn"
                        >
                            <i class="bi bi-list"></i>
                        </button>
                        <nav id="lmsNav" class="header-nav collapse">
                            <a class="header-nav-item" href="<%= ResolveUrl("~/lms/dashboard") %>">Tổng quan</a>
                            <a class="header-nav-item" href="<%= ResolveUrl("~/lms/courses") %>">Môn học của tôi</a>
                            <a class="header-nav-item" href="<%= ResolveUrl("~/lms/results") %>">Kết quả</a>
                        </nav>
                        <div class="header-actions">
                            <div class="notification-center" data-notification-center data-handler-url="<%= ResolveUrl("~/Handlers/Lms/Module.ashx") %>">
                                <button
                                    type="button"
                                    class="header-action-btn"
                                    data-notification-toggle
                                    aria-label="Thông báo"
                                >
                                    <i class="bi bi-bell"></i>
                                    <span class="badge-count"><asp:Literal ID="NotificationCountText" runat="server" /></span>
                                </button>
                                <div class="notification-panel" data-notification-panel hidden>
                                    <div class="notification-panel-head">
                                        <strong>Thông báo</strong>
                                        <button type="button" class="btn btn-sm btn-link" data-notification-read-all>Đọc tất cả</button>
                                    </div>
                                    <div data-notification-list class="notification-list">
                                        <span class="text-secondary">Đang tải...</span>
                                    </div>
                                </div>
                            </div>
                            <a href="<%= ResolveUrl("~/lms/profile") %>" class="header-user">
                                <img class="header-user-avatar" src="<%= ResolveUrl("~/assets/lms/images/avatar-student.jpg") %>" alt="Ảnh đại diện" />
                                <div class="header-user-info d-none d-xl-block">
                                    <div class="header-user-name"><asp:Literal ID="UserNameText" runat="server" /></div>
                                    <div class="header-user-role">Học viên</div>
                                </div>
                            </a>
                            <a class="header-action-btn btn-danger" href="<%= ResolveUrl("~/logout") %>" title="Đăng xuất" aria-label="Đăng xuất">
                                <i class="bi bi-box-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </header>
                <main class="main-content main-centered"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
                <footer class="lms-footer">
                    <div class="container">
                        <span>© 2026 Thiên Hà Số · Hệ thống quản lý học tập</span>
                        <span>Hỗ trợ · Quy định học tập · Bảo mật</span>
                    </div>
                </footer>
            </div>
            <script src="<%= ResolveUrl("~/assets/lms/vendor/bootstrap.bundle.min.js") %>"></script>
            <script src="<%= ResolveUrl("~/assets/lms/js/app.js?v=20260901-ui5") %>"></script>
            <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
        </form>
    </body>
</html>
