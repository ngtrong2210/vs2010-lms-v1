<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="urlrewritingnet"
             type="UrlRewritingNet.Configuration.UrlRewriteSection, UrlRewritingNet.UrlRewriter"
             requirePermission="false"
             restartOnExternalChanges="true" />
  </configSections>

  <urlrewritingnet configSource="urlrewrite.config" />

  <connectionStrings>
    <add name="_ConnectionString"
         connectionString="Data Source=DESKTOP-PBMQQ03\SQLEXPRESS;Initial Catalog=LMSCMS_DB;User ID=sa;Password=nQY3n9EGcjT#pju;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- DCore.Data.CreateData() lấy tên chuỗi kết nối từ khóa này. -->
    <add key="ConnectStringName" value="_ConnectionString" />
    <add key="DefaultLanguage" value="vi-VN" />
    <add key="Sql.CommandTimeoutSeconds" value="120" />
    <add key="Media.VideoPath" value="~/Media/Video" />
    <add key="Media.ImagePath" value="~/Media/Image" />
    <add key="Media.FilePath" value="~/Media/File" />
    <add key="Media.ThumbnailPath" value="~/Media/Thumbnail" />
    <add key="Media.AudioPath" value="~/Media/Audio" />
    <add key="Media.MaxVideoFileSizeMB" value="500" />
    <add key="Media.MaxLearningFileSizeMB" value="200" />
    <add key="Storage.TempPath" value="~/App_Data/Temp" />
    <add key="Storage.LogPath" value="~/App_Data/Logs" />
  </appSettings>

  <system.web>
    <globalization requestEncoding="utf-8"
                   responseEncoding="utf-8"
                   fileEncoding="utf-8"
                   culture="vi-VN"
                   uiCulture="vi-VN" />
    <httpRuntime executionTimeout="3600"
                 maxRequestLength="512000"
                 requestValidationMode="2.0"
                 targetFramework="4.0" />
    <compilation debug="true" targetFramework="4.0" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/error">
      <error statusCode="403" redirect="~/403" />
      <error statusCode="404" redirect="~/404" />
    </customErrors>
    <sessionState timeout="120" mode="InProc" cookieless="UseCookies" />
    <authentication mode="Forms">
      <forms name=".THIENHASO.AUTH"
             loginUrl="~/login"
             defaultUrl="~/lms/dashboard"
             protection="All"
             timeout="120"
             slidingExpiration="true"
             path="/" />
    </authentication>
    <authorization>
      <allow users="*" />
    </authorization>
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
    <pages validateRequest="true"
           enableEventValidation="true"
           controlRenderingCompatibilityVersion="3.5"
           clientIDMode="AutoID" />
    <httpModules>
      <add name="UrlRewriteModule" type="UrlRewritingNet.Web.UrlRewriteModule, UrlRewritingNet.UrlRewriter" />
      <add name="ScriptModule" type="System.Web.Handlers.ScriptModule, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
    </httpModules>
    <httpHandlers />
  </system.web>

  <location path="Pages/Auth">
    <system.web>
      <pages theme="" />
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Pages/Lms"><system.web><pages theme="" /></system.web></location>
  <location path="Pages/Cms"><system.web><pages theme="" /></system.web></location>
  <location path="Pages/Errors"><system.web><pages theme="" /></system.web></location>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true">
      <add name="UrlRewriteModule" type="UrlRewritingNet.Web.UrlRewriteModule, UrlRewritingNet.UrlRewriter" />
    </modules>
    <staticContent>
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
