<?xml version="1.0" encoding="utf-8"?>
<urlrewritingnet rewriteOnlyVirtualUrls="true"
                 contextItemsPrefix="QueryString"
                 defaultProvider="RegEx"
                 xmlns="http://www.urlrewriting.net/schemas/config/2006/07">
  <rewrites>
    <!-- Chỉ giữ các URL hệ thống của LMS; không mang lại rule nội dung của source cũ. -->
    <add name="Login"
         virtualUrl="^~/login/?$"
         rewriteUrlParameter="ExcludeFromClientQueryString"
         destinationUrl="~/Pages/Auth/Login.aspx"
         ignoreCase="true"
         stopProcessing="true" />
    <add name="Logout"
         virtualUrl="^~/logout/?$"
         rewriteUrlParameter="ExcludeFromClientQueryString"
         destinationUrl="~/Pages/Auth/Logout.aspx"
         ignoreCase="true"
         stopProcessing="true" />
    <add name="Forbidden"
         virtualUrl="^~/403/?$"
         rewriteUrlParameter="ExcludeFromClientQueryString"
         destinationUrl="~/Pages/Errors/Forbidden.aspx"
         ignoreCase="true"
         stopProcessing="true" />
    <add name="NotFound"
         virtualUrl="^~/404/?$"
         rewriteUrlParameter="ExcludeFromClientQueryString"
         destinationUrl="~/Pages/Errors/NotFound.aspx"
         ignoreCase="true"
         stopProcessing="true" />
    <add name="Error"
         virtualUrl="^~/error/?$"
         rewriteUrlParameter="ExcludeFromClientQueryString"
         destinationUrl="~/Pages/Errors/Error.aspx"
         ignoreCase="true"
         stopProcessing="true" />
  </rewrites>
</urlrewritingnet>
